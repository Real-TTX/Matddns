<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Matddns</RootNamespace>
    <AssemblyName>Matddns</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- For the copy of MatPlatform (folder MatPlatform/, from MatDesign): the sign-in through MatIdentity and its tokens on /api. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Matddns.Tests" />
  </ItemGroup>

</Project>
