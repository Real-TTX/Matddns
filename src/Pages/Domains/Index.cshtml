@page
@model Matddns.Pages.Domains.IndexModel
@{
    ViewData["Title"] = "Domains";
    ViewData["Reconnect"] = "reload";
    ViewData["Crumbs"] = Crumbs.Of(("Domains", null));
    var list = Model.List;
}

<div class="mat-list">
    <partial name="_Toolbar" model="list.Toolbar" />

    @if (list.Items.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon"><icon name="globe" /></span>
            @if (list.Toolbar.Total == 0)
            {
                <div class="mat-empty__title">No domain groups yet</div>
                <a class="mat-btn mat-btn--primary" href="/Domains/Edit"><icon name="plus" /><span>Create the first group</span></a>
            }
            else
            {
                <div class="mat-empty__title">Nothing matches</div>
                <p>No group matches. Change the search or the filter.</p>
                <a class="mat-btn mat-btn--secondary" href="/Domains">Reset the tools</a>
            }
        </div>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Domain groups and their records</caption>
                <thead>
                    <tr><th scope="col">Name</th><th scope="col" class="mat-hide-sm">Provider</th><th scope="col">Record</th><th scope="col">Type</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr>
                </thead>
                <tbody>
                @foreach (var g in list.Items)
                {
                    var entries = g.Entries.ToList();
                    var dynForZone = Model.DynamicRules.Where(r => r.DomainGroupId == g.Id).ToList();
                    var childCount = entries.Count + dynForZone.Count;
                    <tr class="md-parent @(childCount > 0 ? "has-children" : "")">
                        <td data-label="Name"><div class="mat-table__name"><a href="/Domains/Edit?id=@g.Id">@g.Name</a><partial name="_ManagedBadge" model="g.ManagedBy" /></div></td>
                        <td data-label="Provider" class="mat-hide-sm"><span class="mat-tag">@Labels.Domain(g.Kind)</span> @if (dynForZone.Count > 0) { <span class="mat-tag">dynamic</span> }</td>
                        <td data-label="Records" class="mat-muted">@entries.Count record@(entries.Count == 1 ? "" : "s")</td>
                        <td data-label="Type"></td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Domains/Edit?id=@g.Id" aria-label="Edit @g.Name" data-tip="Edit"><icon name="edit" /></a>
                            </div>
                        </td>
                    </tr>
                    @for (var i = 0; i < entries.Count; i++)
                    {
                        var e = entries[i];
                        <tr class="md-child @(i == childCount - 1 ? "is-last" : "")">
                            <td data-label="Group"></td>
                            <td data-label="Provider" class="mat-hide-sm"></td>
                            <td data-label="Record" class="mat-mono"><span class="md-child__name">@e.Hostname</span></td>
                            <td data-label="Type"><span class="mat-tag">@e.Type</span></td>
                            <td></td>
                        </tr>
                    }
                    @for (var j = 0; j < dynForZone.Count; j++)
                    {
                        var dr = dynForZone[j];
                        <tr class="md-child @(entries.Count + j == childCount - 1 ? "is-last" : "")">
                            <td data-label="Group"></td>
                            <td data-label="Provider" class="mat-hide-sm"></td>
                            <td data-label="Record" class="mat-mono"><span class="md-child__name">*.@dr.DynamicBaseFqdn</span></td>
                            <td data-label="Type"><span class="mat-tag">dynamic</span></td>
                            <td></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }

    <partial name="_Pager" model="list.Pager" />

    <div class="mat-actions">
        <a href="/Domains/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New domain group</span></a>
    </div>
</div>
