@page
@model Matddns.Pages.Domains.EditModel
@{
    var g = Model.Group;
    var isNew = Model.IsNew;
    ViewData["Title"] = isNew ? "New domain group" : g!.Name;
    var kind = g?.Kind ?? DomainKind.DynDns;
    var zoneBased = kind is DomainKind.Netcup or DomainKind.Cloudflare or DomainKind.Hetzner or DomainKind.GoDaddy;   // record-name + zone, like Netcup
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@(isNew ? "New domain group" : g!.Name)</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notice)) { <div class="alert alert--success"><icon name="check-circle" /><span>@Model.Notice</span></div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div> }

<div class="card">
    <div class="card__body">
        <form method="post" asp-page-handler="@(isNew ? "Create" : "Save")" class="mat-form">
            @if (!isNew) { <input type="hidden" name="Id" value="@g!.Id" /> }

            <div class="form-grid">
                <div class="mat-field span-2">
                    <label class="mat-label" for="Name">Name</label>
                    <input type="text" id="Name" name="Name" value="@(g?.Name ?? "")" class="mat-input" required placeholder="e.g. Netcup main account" />
                </div>

                <div class="mat-field span-2">
                    <label class="mat-label" for="@(isNew ? "kindSelect" : "kindFixed")">Type</label>
                    @if (isNew)
                    {
                        <select name="Kind" id="kindSelect" class="mat-select">
                            <option value="DynDns">DynDNS</option>
                            <option value="Netcup">Netcup</option>
                            <option value="Cloudflare">Cloudflare</option>
                            <option value="Hetzner">Hetzner DNS</option>
                            <option value="GoDaddy">GoDaddy</option>
                            <option value="Matddns">Matddns peer</option>
                        </select>
                    }
                    else
                    {
                        var kindLabel = kind switch { DomainKind.Netcup => "Netcup", DomainKind.Cloudflare => "Cloudflare", DomainKind.Hetzner => "Hetzner DNS", DomainKind.GoDaddy => "GoDaddy", DomainKind.Matddns => "Matddns peer", _ => "DynDNS" };
                        <input type="text" id="kindFixed" value="@kindLabel" class="mat-input" disabled />
                    }
                </div>
            </div>

            @* The type-specific fields: all are in the form, only the block of the chosen type is shown (data-show-if). *@

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="DynDns" hidden="@(kind != DomainKind.DynDns)">
                <div class="form-grid">
                    <div class="mat-field span-2">
                        <label class="mat-label" for="dynProvider">Provider preset</label>
                        <select id="dynProvider" class="mat-select">
                            <option value="">Custom / manual</option>
                            <option value="matddns">Matddns (another instance)</option>
                            <option value="changeip">ChangeIP</option>
                            <option value="ddnss">DDNSS.de</option>
                            <option value="desec">deSEC</option>
                            <option value="dd24">Domain Discount 24</option>
                            <option value="duckdns">DuckDNS</option>
                            <option value="dyndns">DynDNS.org</option>
                            <option value="dnsomatic">DNS-O-Matic</option>
                            <option value="dynu">Dynu</option>
                            <option value="dynv6">DynV6</option>
                            <option value="easydns">EasyDNS</option>
                            <option value="freedns">FreeDNS (afraid.org)</option>
                            <option value="goip">GoIP.de</option>
                            <option value="henet">Hurricane Electric</option>
                            <option value="ipv64">ipv64.net</option>
                            <option value="noip">No-IP</option>
                            <option value="nowdns">Now-DNS</option>
                            <option value="opendns">OpenDNS</option>
                            <option value="selfhost">Selfhost.de</option>
                            <option value="spdyn">SPDYN</option>
                            <option value="strato">Strato</option>
                            <option value="variomedia">Variomedia</option>
                            <option value="zoneedit">Zoneedit</option>
                        </select>
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-label" for="dynUrlInput">Update URL</label>
                        <input type="text" id="dynUrlInput" name="DynUrl" value="@(g?.DynDns?.UpdateUrl ?? "")" class="mat-input" placeholder="https://example.org/nic/update?hostname={hostname}&myip={ipv4}&myipv6={ipv6}" autocapitalize="none" spellcheck="false" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="DynUser">Username</label>
                        <input type="text" id="DynUser" name="DynUser" value="@(g?.DynDns?.Username ?? "")" class="mat-input" autocomplete="off" autocapitalize="none" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="DynPass">Password / Token</label>
                        <input type="password" id="DynPass" name="DynPass" class="mat-input" placeholder="@(isNew ? "" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Netcup" hidden="@(kind != DomainKind.Netcup)">
                <div class="form-grid">
                    <div class="mat-field">
                        <label class="mat-label" for="NcCustomer">Customer no.</label>
                        <input type="text" id="NcCustomer" name="NcCustomer" value="@(g?.Netcup?.CustomerNumber ?? "")" class="mat-input" inputmode="numeric" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="NcKey">API key</label>
                        <input type="password" id="NcKey" name="NcKey" class="mat-input" placeholder="@(isNew ? "" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-label" for="NcPass">API password</label>
                        <input type="password" id="NcPass" name="NcPass" class="mat-input" placeholder="@(isNew ? "" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-switch">
                            <input type="checkbox" name="NcAllowDynamic" value="true" @(g?.Netcup?.AllowDynamic == true ? "checked" : "") />
                            <span>Allow dynamic records (create on demand)</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Cloudflare" hidden="@(kind != DomainKind.Cloudflare)">
                <div class="form-grid">
                    <div class="mat-field span-2">
                        <label class="mat-label" for="CfToken">API token</label>
                        <input type="password" id="CfToken" name="CfToken" class="mat-input" placeholder="@(isNew ? "Cloudflare API token (Zone.DNS edit)" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-switch">
                            <input type="checkbox" name="CfAllowDynamic" value="true" @(g?.Cloudflare?.AllowDynamic == true ? "checked" : "") />
                            <span>Allow dynamic records (create on demand)</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Hetzner" hidden="@(kind != DomainKind.Hetzner)">
                <div class="form-grid">
                    <div class="mat-field span-2">
                        <label class="mat-label" for="HzToken">API token</label>
                        <input type="password" id="HzToken" name="HzToken" class="mat-input" placeholder="@(isNew ? "Hetzner DNS API token" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-switch">
                            <input type="checkbox" name="HzAllowDynamic" value="true" @(g?.Hetzner?.AllowDynamic == true ? "checked" : "") />
                            <span>Allow dynamic records (create on demand)</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Matddns" hidden="@(kind != DomainKind.Matddns)">
                <div class="form-grid">
                    <div class="mat-field span-2">
                        <label class="mat-label" for="MdUrl">Peer base URL</label>
                        <input type="text" id="MdUrl" name="MdUrl" value="@(g?.Matddns?.BaseUrl ?? "")" class="mat-input" placeholder="https://dyndns.example.com" autocapitalize="none" spellcheck="false" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-label" for="MdToken">Token</label>
                        <input type="password" id="MdToken" name="MdToken" class="mat-input" placeholder="@(isNew ? "a DynDNS-Server token on the peer" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="GoDaddy" hidden="@(kind != DomainKind.GoDaddy)">
                <div class="form-grid">
                    <div class="mat-field">
                        <label class="mat-label" for="GdKey">API key</label>
                        <input type="password" id="GdKey" name="GdKey" class="mat-input" placeholder="@(isNew ? "" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="GdSecret">API secret</label>
                        <input type="password" id="GdSecret" name="GdSecret" class="mat-input" placeholder="@(isNew ? "" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-switch">
                            <input type="checkbox" name="GdAllowDynamic" value="true" @(g?.GoDaddy?.AllowDynamic == true ? "checked" : "") />
                            <span>Allow dynamic records (create on demand)</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="mat-buttons">
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>@(isNew ? "Create" : "Save")</span></button>
                <a class="mat-btn mat-btn--ghost" href="/Domains"><icon name="back" /><span>Back</span></a>
                @if (!isNew)
                {
                    <span class="mat-buttons__spacer"></span>
                    <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" name="Id" value="@g!.Id" data-confirm="Delete group incl. records and related rules?" data-confirm-ok="Delete group"><icon name="trash" /><span>Delete group</span></button>
                }
            </div>
        </form>
    </div>
</div>

@if (!isNew)
{
    <div class="section-head"><h2 class="section-title">Records</h2></div>
    <div class="mat-table">
        <div class="mat-table__scroll">
        <table class="data">
            <thead>
                <tr>
                    @if (zoneBased)
                    {
                        <th>Record (host)</th>
                        <th class="hide-sm">Zone</th>
                    }
                    <th>Full name</th>
                    <th>Type</th>
                    <th class="actions"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in g!.Entries)
            {
                <tr>
                    @if (zoneBased)
                    {
                        <td class="mono">@(string.IsNullOrEmpty(e.RecordName) ? "@" : e.RecordName)</td>
                        <td class="mono hide-sm">@(e.Domain ?? "—")</td>
                    }
                    <td class="mono">@e.Hostname</td>
                    <td><span class="mat-badge">@e.Type</span></td>
                    <td class="actions">
                        <form method="post" asp-page-handler="DeleteEntry" class="inline-form" data-confirm="Remove record @e.Hostname?" data-confirm-ok="Remove">
                            <input type="hidden" name="Id" value="@g.Id" />
                            <input type="hidden" name="EntryId" value="@e.Id" />
                            <button type="submit" class="mat-btn mat-btn--sm mat-btn--icon mat-btn--danger" title="Remove" aria-label="Remove record"><icon name="trash" /></button>
                        </form>
                    </td>
                </tr>
            }
            @if (g.Entries.Count == 0)
            {
                <tr><td colspan="@(zoneBased ? 5 : 3)" class="text-muted">No records yet.</td></tr>
            }
            </tbody>
        </table>
        </div>

        <form method="post" asp-page-handler="AddEntry" class="mat-table__form mat-form">
            <input type="hidden" name="Id" value="@g.Id" />
            <div class="form-grid">
                @if (zoneBased)
                {
                    <div class="mat-field">
                        <label class="mat-label" for="RecordName">Record / subdomain</label>
                        <input type="text" id="RecordName" name="RecordName" class="mat-input" placeholder="@@, www or home1" autocapitalize="none" spellcheck="false" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="DomainZone">Domain / zone</label>
                        <input type="text" id="DomainZone" name="DomainZone" class="mat-input" required placeholder="example.com" autocapitalize="none" spellcheck="false" />
                    </div>
                }
                else
                {
                    <div class="mat-field span-2">
                        <label class="mat-label" for="Hostname">Hostname (FQDN)</label>
                        <input type="text" id="Hostname" name="Hostname" class="mat-input" required placeholder="home1.example.com" autocapitalize="none" spellcheck="false" />
                    </div>
                }
                <div class="mat-field">
                    <label class="mat-label" for="Type">Type</label>
                    <select id="Type" name="Type" class="mat-select">
                        <option value="A">A</option>
                        <option value="AAAA">AAAA</option>
                        @if (zoneBased) { <option value="CNAME">CNAME</option> }
                    </select>
                </div>
            </div>
            <div class="mat-buttons" style="margin-top:0;">
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add record</span></button>
            </div>
        </form>
    </div>
}

@section Scripts {
<script>
    // DynDNS provider presets -> fill the update URL
    (function () {
        var prov = document.getElementById('dynProvider');
        var url = document.getElementById('dynUrlInput');
        if (!prov || !url) return;
        var presets = {
            matddns: '@Model.BaseUrl/api/update?token={password}&ipv4={ipv4}&ipv6={ipv6}',
            changeip: 'https://nic.changeip.com/nic/update?hostname={hostname}&myip={ipv4}',
            ddnss: 'https://www.ddnss.de/upd.php?key={password}&host={hostname}&ip={ipv4}&ip6={ipv6}',
            desec: 'https://update.dedyn.io/?hostname={hostname}&myipv4={ipv4}&myipv6={ipv6}',
            dd24: 'https://dynamicdns.key-systems.net/update.php?hostname={hostname}&password={password}&ip={ipv4}',
            duckdns: 'https://www.duckdns.org/update?domains={hostname}&token={password}&ip={ipv4}&ipv6={ipv6}',
            dyndns: 'https://members.dyndns.org/v3/update?hostname={hostname}&myip={ipv4}&myipv6={ipv6}',
            dnsomatic: 'https://updates.dnsomatic.com/nic/update?hostname={hostname}&myip={ipv4}',
            dynu: 'https://api.dynu.com/nic/update?hostname={hostname}&myip={ipv4}&myipv6={ipv6}',
            dynv6: 'https://dynv6.com/api/update?hostname={hostname}&ipv4={ipv4}&ipv6={ipv6}&token={password}',
            easydns: 'https://api.cp.easydns.com/dyn/tomato.php?hostname={hostname}&myip={ipv4}',
            freedns: 'https://freedns.afraid.org/dynamic/update.php?{password}',
            goip: 'https://www.goip.de/setip?subdomain={hostname}&username={user}&password={password}&ip={ipv4}',
            henet: 'https://dyn.dns.he.net/nic/update?hostname={hostname}&myip={ipv4}',
            ipv64: 'https://ipv64.net/update.php?key={password}&domain={hostname}&ip={ipv4}&ip6={ipv6}',
            noip: 'https://dynupdate.no-ip.com/nic/update?hostname={hostname}&myip={ipv4}&myipv6={ipv6}',
            nowdns: 'https://now-dns.com/update?hostname={hostname}&myip={ipv4}',
            opendns: 'https://updates.opendns.com/nic/update?hostname={hostname}&myip={ipv4}',
            selfhost: 'https://carol.selfhost.de/nic/update?hostname={hostname}&myip={ipv4}',
            spdyn: 'https://update.spdyn.de/nic/update?hostname={hostname}&myip={ipv4}&myipv6={ipv6}',
            strato: 'https://dyndns.strato.com/nic/update?hostname={hostname}&myip={ipv4}&myipv6={ipv6}',
            variomedia: 'https://dyndns.variomedia.de/nic/update?hostname={hostname}&myip={ipv4}&myipv6={ipv6}',
            zoneedit: 'https://dynamic.zoneedit.com/auth/dynamic.html?host={hostname}&dnsto={ipv4}'
        };
        prov.addEventListener('change', function () {
            if (presets[prov.value]) url.value = presets[prov.value];
        });
    })();
</script>
}
