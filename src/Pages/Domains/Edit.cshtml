@page
@model Matddns.Pages.Domains.EditModel
@{
    var g = Model.Group;
    var isNew = Model.IsNew;
    ViewData["Title"] = isNew ? "New domain group" : g!.Name;
    ViewData["ManagedBy"] = g?.ManagedBy;
    ViewData["Crumbs"] = Crumbs.Of(("Domains", "/Domains"), (isNew ? "New domain group" : g!.Name, null));
    ViewData["ActiveHref"] = "/Domains";
    var kind = g?.Kind ?? DomainKind.DynDns;
    var zoneBased = kind is DomainKind.Netcup or DomainKind.Cloudflare or DomainKind.Hetzner or DomainKind.GoDaddy;   // record-name + zone, like Netcup
    var keep = isNew ? "" : "Leave empty to keep the current one";
}

<form method="post" asp-page-handler="@(isNew ? "Create" : "Save")" class="mat-form" novalidate>
    @if (!isNew) { <input type="hidden" name="Id" value="@g!.Id" /> }
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__body mat-stack">
            <div class="mat-form__grid">
                <mat-field label="Name" for-id="Name" required="true" full="true">
                    <input type="text" id="Name" name="Name" value="@(g?.Name ?? "")" class="mat-input" required placeholder="e.g. Netcup main account" data-msg-required="Please enter a name." />
                </mat-field>

                @if (isNew)
                {
                    <mat-field label="Type" for-id="kindSelect" full="true">
                        <select name="Kind" id="kindSelect" class="mat-select">
                            @foreach (var k in Enum.GetValues<DomainKind>())
                            {
                                <option value="@k">@Labels.Domain(k)</option>
                            }
                        </select>
                    </mat-field>
                }
                else
                {
                    <mat-field label="Type" for-id="kindFixed" full="true">
                        <input type="text" id="kindFixed" value="@Labels.Domain(kind)" class="mat-input mat-input--plain" readonly />
                    </mat-field>
                }
            </div>

            @* The type-specific fields: all are in the form, only the block of the chosen type is shown (data-show-if). *@

            <div class="mat-form__grid" data-show-if="#kindSelect" data-show-value="DynDns" hidden="@(kind != DomainKind.DynDns)">
                <mat-field label="Provider preset" for-id="dynProvider" full="true">
                    <select id="dynProvider" class="mat-select" data-url-preset="#dynUrlInput">
                        <option value="">Custom / manual</option>
                        @foreach (var p in DynDnsPresets.All)
                        {
                            <option value="@p.Key" data-url="@p.Url">@p.Label</option>
                        }
                    </select>
                </mat-field>
                <mat-field label="Update URL" for-id="dynUrlInput" full="true">
                    <input type="text" id="dynUrlInput" name="DynUrl" value="@(g?.DynDns?.UpdateUrl ?? "")" class="mat-input mat-mono" placeholder="https://example.org/nic/update?hostname={hostname}&myip={ipv4}&myipv6={ipv6}" autocapitalize="none" spellcheck="false" />
                </mat-field>
                <mat-field label="Username" for-id="DynUser">
                    <input type="text" id="DynUser" name="DynUser" value="@(g?.DynDns?.Username ?? "")" class="mat-input" autocomplete="off" autocapitalize="none" />
                </mat-field>
                <mat-field label="Password or token" for-id="DynPass">
                    <input type="password" id="DynPass" name="DynPass" class="mat-input" placeholder="@keep" autocomplete="new-password" />
                </mat-field>
            </div>

            <div class="mat-form__grid" data-show-if="#kindSelect" data-show-value="Netcup" hidden="@(kind != DomainKind.Netcup)">
                <mat-field label="Customer number" for-id="NcCustomer">
                    <input type="text" id="NcCustomer" name="NcCustomer" value="@(g?.Netcup?.CustomerNumber ?? "")" class="mat-input mat-mono" inputmode="numeric" />
                </mat-field>
                <mat-field label="API key" for-id="NcKey">
                    <input type="password" id="NcKey" name="NcKey" class="mat-input" placeholder="@keep" autocomplete="new-password" />
                </mat-field>
                <mat-field label="API password" for-id="NcPass" full="true">
                    <input type="password" id="NcPass" name="NcPass" class="mat-input" placeholder="@keep" autocomplete="new-password" />
                </mat-field>
                <div class="mat-field mat-field--full">
                    <label class="mat-check"><input type="checkbox" id="NcAllowDynamic" name="NcAllowDynamic" value="true" checked="@(g?.Netcup?.AllowDynamic == true)" /><span class="mat-check__text">Allow dynamic records (create them on demand)</span></label>
                </div>
            </div>

            <div class="mat-form__grid" data-show-if="#kindSelect" data-show-value="Cloudflare" hidden="@(kind != DomainKind.Cloudflare)">
                <mat-field label="API token" for-id="CfToken" full="true">
                    <input type="password" id="CfToken" name="CfToken" class="mat-input" placeholder="@(isNew ? "Cloudflare API token (Zone.DNS edit)" : keep)" autocomplete="new-password" />
                </mat-field>
                <div class="mat-field mat-field--full">
                    <label class="mat-check"><input type="checkbox" id="CfAllowDynamic" name="CfAllowDynamic" value="true" checked="@(g?.Cloudflare?.AllowDynamic == true)" /><span class="mat-check__text">Allow dynamic records (create them on demand)</span></label>
                </div>
            </div>

            <div class="mat-form__grid" data-show-if="#kindSelect" data-show-value="Hetzner" hidden="@(kind != DomainKind.Hetzner)">
                <mat-field label="API token" for-id="HzToken" full="true">
                    <input type="password" id="HzToken" name="HzToken" class="mat-input" placeholder="@(isNew ? "Cloud API token (read & write)" : keep)" autocomplete="new-password" />
                </mat-field>
                <div class="mat-field mat-field--full">
                    <label class="mat-check"><input type="checkbox" id="HzAllowDynamic" name="HzAllowDynamic" value="true" checked="@(g?.Hetzner?.AllowDynamic == true)" /><span class="mat-check__text">Allow dynamic records (create them on demand)</span></label>
                </div>
            </div>

            <div class="mat-form__grid" data-show-if="#kindSelect" data-show-value="Matddns" hidden="@(kind != DomainKind.Matddns)">
                <mat-field label="Peer base URL" for-id="MdUrl" full="true">
                    <input type="url" id="MdUrl" name="MdUrl" value="@(g?.Matddns?.BaseUrl ?? "")" class="mat-input" placeholder="https://dyndns.example.com" autocapitalize="none" spellcheck="false" data-msg-type="Please enter an address like https://dyndns.example.com." />
                </mat-field>
                <mat-field label="Token" for-id="MdToken" full="true">
                    <input type="password" id="MdToken" name="MdToken" class="mat-input" placeholder="@(isNew ? "A DynDNS Server token on the peer" : keep)" autocomplete="new-password" />
                </mat-field>
            </div>

            <div class="mat-form__grid" data-show-if="#kindSelect" data-show-value="GoDaddy" hidden="@(kind != DomainKind.GoDaddy)">
                <mat-field label="API key" for-id="GdKey">
                    <input type="password" id="GdKey" name="GdKey" class="mat-input" placeholder="@keep" autocomplete="new-password" />
                </mat-field>
                <mat-field label="API secret" for-id="GdSecret">
                    <input type="password" id="GdSecret" name="GdSecret" class="mat-input" placeholder="@keep" autocomplete="new-password" />
                </mat-field>
                <div class="mat-field mat-field--full">
                    <label class="mat-check"><input type="checkbox" id="GdAllowDynamic" name="GdAllowDynamic" value="true" checked="@(g?.GoDaddy?.AllowDynamic == true)" /><span class="mat-check__text">Allow dynamic records (create them on demand)</span></label>
                </div>
            </div>
        </div>
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>@(isNew ? "Create" : "Save")</span></button>
        <a class="mat-btn mat-btn--secondary" href="/Domains"><icon name="back" /><span>Back</span></a>
        @if (!isNew)
        {
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" name="Id" value="@g!.Id" data-confirm="Delete the group @g.Name with its records and the rules that use them?" data-confirm-ok="Delete group"><icon name="trash" /><span>Delete</span></button>
        }
    </div>
</form>

@if (!isNew)
{
    <section class="mat-section">
        <div class="mat-section__head"><h2>Records</h2></div>
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Records of @g!.Name</caption>
                <thead>
                    <tr>
                        @if (zoneBased)
                        {
                            <th scope="col">Record</th>
                            <th scope="col" class="mat-hide-sm">Zone</th>
                        }
                        <th scope="col">Full name</th>
                        <th scope="col">Type</th>
                        <th scope="col"><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in g.Entries)
                {
                    <tr>
                        @if (zoneBased)
                        {
                            <td data-label="Record" class="mat-mono">@(string.IsNullOrEmpty(e.RecordName) ? "@" : e.RecordName)</td>
                            <td data-label="Zone" class="mat-hide-sm mat-mono">@(e.Domain ?? "–")</td>
                        }
                        <td data-label="Full name" class="mat-mono">@e.Hostname</td>
                        <td data-label="Type"><span class="mat-tag">@e.Type</span></td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <form method="post" asp-page-handler="DeleteEntry" data-confirm="Remove the record @e.Hostname (@e.Type) and the rules that use it?" data-confirm-ok="Remove" data-confirm-danger>
                                    <input type="hidden" name="Id" value="@g.Id" />
                                    <input type="hidden" name="EntryId" value="@e.Id" />
                                    <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" aria-label="Remove @e.Hostname (@e.Type)" data-tip="Remove"><icon name="trash" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (g.Entries.Count == 0)
                {
                    <tr><td colspan="@(zoneBased ? 5 : 3)" class="mat-muted">No records yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="mat-section">
        <div class="mat-section__head"><h2>Add a record</h2></div>
        <form method="post" asp-page-handler="AddEntry" class="mat-form" novalidate>
            <input type="hidden" name="Id" value="@g.Id" />
            <div class="mat-card">
                <div class="mat-card__body">
                    <div class="mat-form__grid">
                        @if (zoneBased)
                        {
                            <mat-field label="Record or subdomain" for-id="RecordName">
                                <input type="text" id="RecordName" name="RecordName" class="mat-input mat-mono" placeholder="@@, www or home1" autocapitalize="none" spellcheck="false" />
                            </mat-field>
                            <mat-field label="Domain or zone" for-id="DomainZone" required="true">
                                <input type="text" id="DomainZone" name="DomainZone" class="mat-input mat-mono" required placeholder="example.com" autocapitalize="none" spellcheck="false" data-msg-required="Please enter the zone, for example example.com." />
                            </mat-field>
                        }
                        else
                        {
                            <mat-field label="Hostname (FQDN)" for-id="Hostname" required="true" full="true">
                                <input type="text" id="Hostname" name="Hostname" class="mat-input mat-mono" required placeholder="home1.example.com" autocapitalize="none" spellcheck="false" data-msg-required="Please enter the full hostname." />
                            </mat-field>
                        }
                        <mat-field label="Type" for-id="Type">
                            <select id="Type" name="Type" class="mat-select">
                                <option value="A">A</option>
                                <option value="AAAA">AAAA</option>
                                @if (zoneBased) { <option value="CNAME">CNAME</option> }
                            </select>
                        </mat-field>
                    </div>
                </div>
            </div>
            <div class="mat-actions">
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add record</span></button>
            </div>
        </form>
    </section>
}
