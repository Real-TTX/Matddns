@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login">
    <div class="login__brand">
        <img src="~/favicon.svg" alt="Matddns" />
        <span class="name">Matddns</span>
    </div>

    <div class="card">
        <div class="card__body">
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div>
            }

            <form method="post" class="mat-form">
                <div class="mat-field">
                    <label class="mat-label" for="Username">Username</label>
                    <input type="text" id="Username" name="Username" value="@Model.Username" class="mat-input" autofocus autocomplete="username" autocapitalize="none" spellcheck="false" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="Password">Password</label>
                    <input type="password" id="Password" name="Password" class="mat-input" autocomplete="current-password" />
                </div>
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="login" /><span>Sign in</span></button>
            </form>
        </div>
    </div>
</div>
