@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Reconnect"] = "reload";   // read-only page: show fresh data again once the server is back
    ViewData["AutoRefresh"] = 30000;
    ViewData["Refresh"] = true;
    var s = Model.Snapshot;
    var zone = Tz.Label();
}

<div class="mat-grid mat-grid--4">
    <div class="mat-card"><div class="mat-card__body mat-stat">
        <span class="mat-stat__label">Source IPs OK</span>
        <span class="mat-stat__value">@s.Sources.Ok / @s.Sources.Entries</span>
        @if (s.Sources.Errors == 0)
        {
            <span class="mat-stat__delta">No source has an error</span>
        }
        else
        {
            <span class="mat-stat__delta mat-stat__delta--down"><icon name="alert" /><span>@s.Sources.Errors with an error</span></span>
        }
    </div></div>
    <div class="mat-card"><div class="mat-card__body mat-stat">
        <span class="mat-stat__label">Rules OK</span>
        <span class="mat-stat__value">@s.Rules.Ok / @s.Rules.Total</span>
        @if (s.Rules.Issues == 0)
        {
            <span class="mat-stat__delta">No rule has a problem</span>
        }
        else
        {
            <span class="mat-stat__delta mat-stat__delta--down"><icon name="alert" /><span>@s.Rules.Issues with a problem</span></span>
        }
    </div></div>
    <div class="mat-card"><div class="mat-card__body mat-stat">
        <span class="mat-stat__label">IP changes (24 h)</span>
        <span class="mat-stat__value">@s.IpChanges.Last24h</span>
        <span class="mat-stat__delta">@s.IpChanges.Last7d in the last 7 days</span>
    </div></div>
    <div class="mat-card"><div class="mat-card__body mat-stat">
        <span class="mat-stat__label">Errors (24 h)</span>
        <span class="mat-stat__value">@s.ErrorsLast24h</span>
        @if (s.ErrorsLast24h == 0)
        {
            <span class="mat-stat__delta">None in the log</span>
        }
        else
        {
            <span class="mat-stat__delta mat-stat__delta--down"><icon name="alert" /><a href="/Log?level=Error">See the log</a></span>
        }
    </div></div>
</div>

<section class="mat-section">
    <div class="mat-section__head"><div class="mat-row mat-row--between"><h2>Sources</h2><a class="mat-btn mat-btn--ghost mat-btn--sm" href="/Sources">Manage</a></div></div>
    <div class="mat-table-wrap">
        <table class="mat-table">
            <caption class="mat-sr-only">Sources and their current addresses</caption>
            <thead><tr><th scope="col">Source</th><th scope="col">IPv4</th><th scope="col" class="mat-hide-sm">IPv6</th><th scope="col" class="mat-hide-sm">Last check (@zone)</th><th scope="col">Status</th></tr></thead>
            <tbody>
            @foreach (var src in s.SourceList)
            {
                var kindLabel = Enum.TryParse<SourceKind>(src.Kind, out var sk) ? Labels.Source(sk) : src.Kind;
                var entries = src.Entries;
                var multi = entries.Count > 1;
                var first = entries.FirstOrDefault();
                <tr class="md-parent @(multi ? "has-children" : "")">
                    <td data-label="Source"><div class="mat-table__name"><span>@src.Name <small class="mat-muted">@kindLabel</small></span></div></td>
                    @if (multi || first == null)
                    {
                        <td data-label="IPv4"></td>
                        <td data-label="IPv6" class="mat-hide-sm"></td>
                        <td data-label="Last check" class="mat-hide-sm"></td>
                        <td data-label="Status"></td>
                    }
                    else
                    {
                        var noIp = string.IsNullOrEmpty(first.Ip) && string.IsNullOrEmpty(first.Ipv6);
                        var st = first.Error != null ? "err" : (noIp ? "warn" : "ok");
                        <td data-label="IPv4" class="mat-mono">@(first.Ip ?? "–")</td>
                        <td data-label="IPv6" class="mat-hide-sm mat-mono">@(first.Ipv6 ?? "–")</td>
                        <td data-label="Last check" class="mat-hide-sm mat-muted mat-nowrap">@Tz.Format(first.LastChecked)</td>
                        <td data-label="Status"><span class="@Ui.Pill(st)" title="@(first.Error ?? "")">@(first.Error != null ? "Error" : (noIp ? "Pending" : "OK"))</span></td>
                    }
                </tr>
                @if (multi)
                {
                    for (var i = 0; i < entries.Count; i++)
                    {
                        var e = entries[i];
                        var noIp = string.IsNullOrEmpty(e.Ip) && string.IsNullOrEmpty(e.Ipv6);
                        var st = e.Error != null ? "err" : (noIp ? "warn" : "ok");
                        <tr class="md-child @(i == entries.Count - 1 ? "is-last" : "")">
                            <td data-label="Entry"><span class="md-child__name">@e.Label</span></td>
                            <td data-label="IPv4" class="mat-mono">@(e.Ip ?? "–")</td>
                            <td data-label="IPv6" class="mat-hide-sm mat-mono">@(e.Ipv6 ?? "–")</td>
                            <td data-label="Last check" class="mat-hide-sm mat-nowrap">@Tz.Format(e.LastChecked)</td>
                            <td data-label="Status"><span class="@Ui.Pill(st)" title="@(e.Error ?? "")">@(e.Error != null ? "Error" : (noIp ? "Pending" : "OK"))</span></td>
                        </tr>
                    }
                }
            }
            @if (s.SourceList.Count == 0)
            {
                <tr><td colspan="5" class="mat-muted">No sources configured. <a href="/Sources/Edit">Add one</a>.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="mat-section">
    <div class="mat-section__head"><div class="mat-row mat-row--between"><h2>Rules</h2><a class="mat-btn mat-btn--ghost mat-btn--sm" href="/Rules">Manage</a></div></div>
    <div class="mat-table-wrap">
        <table class="mat-table">
            <caption class="mat-sr-only">Rules, the value they last set and their sources in failover order</caption>
            <thead><tr><th scope="col">Target</th><th scope="col" class="mat-hide-sm">Group</th><th scope="col">Last set</th><th scope="col" class="mat-hide-sm">When (@zone)</th><th scope="col">Status</th></tr></thead>
            <tbody>
            @foreach (var r in s.RuleList)
            {
                var st = !r.Enabled ? "none" : (r.Issue ? "err" : (r.Ok ? "ok" : "warn"));
                var hasSrc = r.Sources.Count > 0;
                <tr class="md-parent @(hasSrc ? "has-children" : "")">
                    <td data-label="Target"><div class="mat-table__name"><span class="mat-tag">@r.Type</span><span class="mat-mono">@r.Target</span></div></td>
                    <td data-label="Group" class="mat-hide-sm mat-muted">@(r.Group ?? "–")</td>
                    <td data-label="Last set" class="mat-mono">@(r.LastValue ?? "–")</td>
                    <td data-label="When" class="mat-hide-sm mat-muted mat-nowrap">@Tz.Format(r.LastChange, "yyyy-MM-dd HH:mm")</td>
                    <td data-label="Status"><span class="@Ui.Pill(st)">@(!r.Enabled ? "Disabled" : (r.Issue ? "Problem" : (r.Ok ? "OK" : "Pending")))</span></td>
                </tr>
                @for (var i = 0; i < r.Sources.Count; i++)
                {
                    var src = r.Sources[i];
                    var sip = src.AddressFor(r.Type);
                    var sstate = src.Missing ? "err" : (src.Active ? "ok" : (string.IsNullOrEmpty(sip) ? "warn" : "none"));
                    <tr class="md-child @(i == r.Sources.Count - 1 ? "is-last" : "")">
                        <td data-label="Source"><span class="md-child__name">#@(i + 1) @src.Name</span></td>
                        <td data-label="Group" class="mat-hide-sm"></td>
                        <td data-label="Address" class="mat-mono">@(sip ?? "–")</td>
                        <td data-label="When" class="mat-hide-sm"></td>
                        <td data-label="Status"><span class="@Ui.Pill(sstate)">@(src.Missing ? "Missing" : (src.Active ? "Active" : (string.IsNullOrEmpty(sip) ? "No IP" : "Standby")))</span></td>
                    </tr>
                }
            }
            @if (s.RuleList.Count == 0)
            {
                <tr><td colspan="5" class="mat-muted">No rules configured. <a href="/Rules/Edit">Add one</a>.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="mat-section">
    <div class="mat-section__head"><div class="mat-row mat-row--between"><h2>Recent IP changes</h2><a class="mat-btn mat-btn--ghost mat-btn--sm" href="/Log?level=Update">Full log</a></div></div>
    <div class="mat-table-wrap">
        <table class="mat-table">
            <caption class="mat-sr-only">The latest changes of an address</caption>
            <thead><tr><th scope="col">Time (@zone)</th><th scope="col">Target</th><th scope="col" class="mat-hide-sm">Detail</th></tr></thead>
            <tbody>
            @foreach (var c in s.IpChanges.Recent)
            {
                <tr>
                    <td data-label="Time" class="mat-mono mat-nowrap">@Tz.Format(c.Time)</td>
                    <td data-label="Target" class="mat-mono">@c.Target</td>
                    <td data-label="Detail" class="mat-hide-sm mat-muted">@c.Detail</td>
                </tr>
            }
            @if (s.IpChanges.Recent.Count == 0)
            {
                <tr><td colspan="3" class="mat-muted">No IP changes recorded yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
