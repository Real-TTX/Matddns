@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Reconnect"] = "reload";   // read-only page: show fresh data again once the server is back
    ViewData["AutoRefresh"] = 30000;
    var s = Model.Snapshot;
}

<div class="page-head">
    <div class="page-head__title">
        <h1>Dashboard</h1>
        <span class="text-muted small">All times in @Tz.Label()</span>
    </div>
    <form method="get"><button type="submit" class="mat-btn mat-btn--ghost"><icon name="refresh" /><span>Refresh</span></button></form>
</div>

<div class="widgets">
    <div class="widget @(s.Sources.Errors == 0 ? "widget--ok" : "widget--err")" title="@(s.Sources.Errors) source error(s)">
        <span class="widget__icon"><icon name="network" /></span>
        <div>
            <div class="widget__value">@s.Sources.Ok<small>/@s.Sources.Entries</small></div>
            <div class="widget__label">Source IPs OK</div>
        </div>
    </div>
    <div class="widget @(s.Rules.Issues == 0 ? "widget--ok" : "widget--err")" title="@(s.Rules.Issues) rule issue(s)">
        <span class="widget__icon"><icon name="route" /></span>
        <div>
            <div class="widget__value">@s.Rules.Ok<small>/@s.Rules.Total</small></div>
            <div class="widget__label">Rules OK</div>
        </div>
    </div>
    <div class="widget">
        <span class="widget__icon"><icon name="refresh" /></span>
        <div>
            <div class="widget__value">@s.IpChanges.Last24h</div>
            <div class="widget__label">IP changes (24h)</div>
        </div>
    </div>
    <div class="widget @(s.ErrorsLast24h == 0 ? "widget--ok" : "widget--err")" title="@s.ErrorsLast24h error(s) in 24h">
        <span class="widget__icon"><icon name="alert" /></span>
        <div>
            <div class="widget__value">@s.ErrorsLast24h</div>
            <div class="widget__label">Errors (24h)</div>
        </div>
    </div>
</div>

<div class="section-head"><h2 class="section-title">Sources</h2><a href="/Sources">Manage</a></div>
<div class="mat-table">
    <div class="mat-table__scroll">
    <table class="data dtable">
        <thead><tr><th>Source</th><th>IPv4</th><th class="hide-sm">IPv6</th><th class="hide-sm">Last check</th><th>Status</th></tr></thead>
        @foreach (var src in s.SourceList)
        {
            var kindLabel = src.Kind == "Push" ? "DynDNS Server" : src.Kind == "Dns" ? "DNS lookup" : src.Kind == "Fritzbox" ? "FRITZ!Box" : src.Kind == "UnifiCloud" ? "UniFi Cloud" : src.Kind == "Matddns" ? "Matddns peer" : src.Kind;
            var entries = src.Entries;
            var multi = entries.Count > 1;
            var first = entries.FirstOrDefault();
            <tbody class="dt-group">
                <tr class="dt-parent @(multi ? "has-children" : "")">
                    <td class="dt-name">@src.Name <span class="text-muted small">(@kindLabel)</span></td>
                    @if (multi || first == null)
                    {
                        <td></td>
                        <td class="hide-sm"></td>
                        <td class="hide-sm"></td>
                        <td></td>
                    }
                    else
                    {
                        var noIp = string.IsNullOrEmpty(first.Ip) && string.IsNullOrEmpty(first.Ipv6);
                        var st = first.Error != null ? "err" : (noIp ? "warn" : "ok");
                        <td class="mono">@(first.Ip ?? "—")</td>
                        <td class="mono hide-sm">@(first.Ipv6 ?? "—")</td>
                        <td class="hide-sm text-muted small">@Tz.Format(first.LastChecked)</td>
                        <td><span class="pill @Ui.Pill(st)" title="@(first.Error ?? "")">@(first.Error != null ? "error" : (noIp ? "pending" : "ok"))</span></td>
                    }
                </tr>
                @if (multi)
                {
                    for (int i = 0; i < entries.Count; i++)
                    {
                        var e = entries[i];
                        var noIp = string.IsNullOrEmpty(e.Ip) && string.IsNullOrEmpty(e.Ipv6);
                        var st = e.Error != null ? "err" : (noIp ? "warn" : "ok");
                        <tr class="dt-child @(i == entries.Count - 1 ? "last" : "")">
                            <td><span class="dt-sub">@e.Label</span></td>
                            <td class="mono cell-muted">@(e.Ip ?? "—")</td>
                            <td class="mono cell-muted hide-sm">@(e.Ipv6 ?? "—")</td>
                            <td class="hide-sm text-muted small">@Tz.Format(e.LastChecked)</td>
                            <td><span class="pill @Ui.Pill(st)" title="@(e.Error ?? "")">@(e.Error != null ? "error" : (noIp ? "pending" : "ok"))</span></td>
                        </tr>
                    }
                }
            </tbody>
        }
        @if (s.SourceList.Count == 0)
        {
            <tbody><tr><td colspan="5" class="text-muted">No sources configured. <a href="/Sources/Edit">Add one</a>.</td></tr></tbody>
        }
    </table>
    </div>
</div>

<div class="section-head"><h2 class="section-title">Domains</h2><a href="/Domains">Manage</a></div>
<div class="mat-table">
    <div class="mat-table__scroll">
    <table class="data dtable">
        <thead><tr><th>Zone</th><th class="hide-sm">Provider</th><th>Record</th><th>Type</th></tr></thead>
        @foreach (var g in Model.Domains)
        {
            var dkind = g.Kind switch { DomainKind.Netcup => "Netcup API", DomainKind.Cloudflare => "Cloudflare", DomainKind.Hetzner => "Hetzner DNS", DomainKind.GoDaddy => "GoDaddy", DomainKind.Matddns => "Matddns peer", _ => "DynDNS" };
            var dentries = g.Entries;
            var dynForZone = Model.DynamicRules.Where(r => r.DomainGroupId == g.Id).ToList();
            var dchild = dentries.Count + dynForZone.Count;
            <tbody class="dt-group">
                <tr class="dt-parent @(dchild > 0 ? "has-children" : "")">
                    <td class="dt-name">@g.Name</td>
                    <td class="hide-sm"><span class="mat-badge">@dkind</span> @if (dynForZone.Count > 0) { <span class="mat-badge">dynamic</span> }</td>
                    <td class="cell-muted">@dentries.Count record@(dentries.Count == 1 ? "" : "s")</td>
                    <td></td>
                </tr>
                @for (int i = 0; i < dentries.Count; i++)
                {
                    var e = dentries[i];
                    <tr class="dt-child @(i == dchild - 1 ? "last" : "")">
                        <td></td>
                        <td class="hide-sm"></td>
                        <td class="mono"><span class="dt-sub">@e.Hostname</span></td>
                        <td><span class="mat-badge mat-badge--muted">@e.Type</span></td>
                    </tr>
                }
                @for (int j = 0; j < dynForZone.Count; j++)
                {
                    var dr = dynForZone[j];
                    <tr class="dt-child @(dentries.Count + j == dchild - 1 ? "last" : "")">
                        <td></td>
                        <td class="hide-sm"></td>
                        <td class="mono"><span class="dt-sub">*.@dr.DynamicBaseFqdn</span></td>
                        <td><span class="mat-badge">dynamic</span></td>
                    </tr>
                }
            </tbody>
        }
        @if (Model.Domains.Count == 0)
        {
            <tbody><tr><td colspan="4" class="text-muted">No domains configured. <a href="/Domains/Edit">Add one</a>.</td></tr></tbody>
        }
    </table>
    </div>
</div>

<div class="section-head"><h2 class="section-title">Rules</h2><a href="/Rules">Manage</a></div>
<div class="mat-table">
    <div class="mat-table__scroll">
    <table class="data dtable">
        <thead><tr><th>Target</th><th class="hide-sm">Group</th><th>Last set</th><th class="hide-sm">When</th><th>Status</th></tr></thead>
        @foreach (var r in s.RuleList)
        {
            var st = !r.Enabled ? "muted" : (r.Issue ? "err" : (r.Ok ? "ok" : "warn"));
            var hasSrc = r.Sources.Count > 0;
            <tbody class="dt-group">
                <tr class="dt-parent @(hasSrc ? "has-children" : "")">
                    <td class="dt-name"><span class="mat-badge">@r.Type</span> <span class="mono">@r.Target</span></td>
                    <td class="text-muted small hide-sm">@(r.Group ?? "—")</td>
                    <td class="mono">@(r.LastValue ?? "—")</td>
                    <td class="hide-sm text-muted small">@Tz.Format(r.LastChange, "yyyy-MM-dd HH:mm")</td>
                    <td><span class="pill @Ui.Pill(st)">@(!r.Enabled ? "disabled" : (r.Issue ? "issue" : (r.Ok ? "ok" : "pending")))</span></td>
                </tr>
                @for (int i = 0; i < r.Sources.Count; i++)
                {
                    var src = r.Sources[i];
                    var sip = src.Ip ?? src.Ipv6;
                    var sdot = src.Missing ? "err" : (src.Active ? "ok" : (string.IsNullOrEmpty(sip) ? "warn" : "muted"));
                    <tr class="dt-child @(i == r.Sources.Count - 1 ? "last" : "")">
                        <td><span class="dt-sub">#@(i + 1) @src.Name</span></td>
                        <td class="hide-sm"></td>
                        <td class="mono cell-muted">@(sip ?? "—")</td>
                        <td class="hide-sm"></td>
                        <td><span class="pill @Ui.Pill(sdot)">@(src.Missing ? "missing" : (src.Active ? "active" : "standby"))</span></td>
                    </tr>
                }
            </tbody>
        }
        @if (s.RuleList.Count == 0)
        {
            <tbody><tr><td colspan="5" class="text-muted">No rules configured. <a href="/Rules/Edit">Add one</a>.</td></tr></tbody>
        }
    </table>
    </div>
</div>

<div class="section-head"><h2 class="section-title">Recent IP changes</h2><a href="/Log?Level=Update">Full log</a></div>
<div class="mat-table">
    <div class="mat-table__scroll">
    <table class="data">
        <thead><tr><th>Time</th><th>Target</th><th class="hide-sm">Detail</th></tr></thead>
        <tbody>
        @foreach (var c in s.IpChanges.Recent)
        {
            <tr>
                <td class="mono nowrap">@Tz.Format(c.Time)</td>
                <td class="mono">@c.Target</td>
                <td class="text-muted small hide-sm">@c.Detail</td>
            </tr>
        }
        @if (s.IpChanges.Recent.Count == 0)
        {
            <tr><td colspan="3" class="text-muted">No IP changes recorded yet.</td></tr>
        }
        </tbody>
    </table>
    </div>
</div>
