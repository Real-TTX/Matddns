@page
@model SystemModel
@{
    ViewData["Title"] = "System";
    ViewData["Crumbs"] = Crumbs.Of(("System", null));
    var lvl = Model.CurrentLevel;
    var n = Model.Notifications;
    var keep = "Leave empty to keep the current one";
    string Selected(string tab) => Model.Tab == tab ? "true" : "false";
    string? TabIndex(string tab) => Model.Tab == tab ? null : "-1";
}

<div data-tabs>
    <div class="mat-tabs" role="tablist" aria-label="System">
        @foreach (var (id, title) in SystemModel.Tabs)
        {
            <button type="button" class="mat-tab" role="tab" id="tab-@id" aria-controls="panel-@id" aria-selected="@Selected(id)" tabindex="@TabIndex(id)">@title</button>
        }
    </div>

    <div class="mat-tabpanel" role="tabpanel" id="panel-general" aria-labelledby="tab-general" hidden="@(Model.Tab != "general")">
        <form method="post" class="mat-form" novalidate>
            <div class="mat-card">
                <div class="mat-card__head"><icon name="settings" /><h2 class="mat-card__title">Settings</h2></div>
                <div class="mat-card__body mat-stack">
                    <div class="mat-form__grid">
                        <mat-field label="Log level (minimum)" for-id="MinLogLevel">
                            <select id="MinLogLevel" name="MinLogLevel" class="mat-select">
                                <option value="Debug" selected="@(lvl == Matddns.Services.LogLevel.Debug)">Debug</option>
                                <option value="Info" selected="@(lvl == Matddns.Services.LogLevel.Info)">Info</option>
                                <option value="Update" selected="@(lvl == Matddns.Services.LogLevel.Update)">Update</option>
                                <option value="Warn" selected="@(lvl == Matddns.Services.LogLevel.Warn)">Warn</option>
                                <option value="Error" selected="@(lvl == Matddns.Services.LogLevel.Error)">Error</option>
                            </select>
                        </mat-field>

                        <mat-field label="Keep the log for (days)" for-id="LogRetentionDays">
                            <input type="number" id="LogRetentionDays" name="LogRetentionDays" value="@Model.RetentionDays" min="0" max="3650" class="mat-input mat-mono" inputmode="numeric" data-msg-range="Please enter a number of days from 0 to 3650." />
                        </mat-field>

                        <mat-field label="Time zone" for-id="TimeZone" full="true">
                            <select id="TimeZone" name="TimeZone" class="mat-select">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.CurrentTimeZone))">UTC</option>
                                @foreach (var z in Model.Zones)
                                {
                                    <option value="@z.Id" selected="@(z.Id == Model.CurrentTimeZone)">@z.Id</option>
                                }
                            </select>
                        </mat-field>
                    </div>

                    <label class="mat-check">
                        <input type="checkbox" id="AnonymousDashboard" name="AnonymousDashboard" value="true" checked="@Model.AnonymousDashboard" />
                        <span class="mat-check__text">Public dashboard (read-only, no sign-in)</span>
                    </label>

                    <dl class="mat-kv"><dt>Log file</dt><dd class="mat-mono">/data/log.txt, @(string.Format("{0:N0}", Model.LogFileBytes / 1024)) KB</dd></dl>
                </div>
            </div>

            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Clear" data-confirm="Clear the entire log now? This cannot be undone." data-confirm-ok="Clear log"><icon name="trash" /><span>Clear log</span></button>
            </div>
        </form>
    </div>

    <div class="mat-tabpanel" role="tabpanel" id="panel-notifications" aria-labelledby="tab-notifications" hidden="@(Model.Tab != "notifications")">
        <form method="post" asp-page-handler="Notifications" class="mat-form" novalidate>
            <div class="mat-card">
                <div class="mat-card__head"><icon name="bell" /><h2 class="mat-card__title">When</h2></div>
                <div class="mat-card__body mat-stack">
                    <label class="mat-check"><input type="checkbox" name="OnChange" value="true" checked="@n.OnChange" /><span class="mat-check__text">A record gets a new IP</span></label>
                    <label class="mat-check"><input type="checkbox" name="OnFailure" value="true" checked="@n.OnFailure" /><span class="mat-check__text">A record cannot be updated, and when it works again</span></label>
                </div>
            </div>

            <div class="mat-card">
                <div class="mat-card__head"><icon name="mail" /><h2 class="mat-card__title">E-mail</h2></div>
                <div class="mat-card__body mat-stack">
                    <label class="mat-check"><input type="checkbox" id="MailEnabled" name="MailEnabled" value="true" checked="@n.Mail.Enabled" /><span class="mat-check__text">Send e-mails</span></label>
                    <div class="mat-form__grid" data-show-if="#MailEnabled" data-show-value="true" hidden="@(!n.Mail.Enabled)">
                        <mat-field label="SMTP server" for-id="MailHost">
                            <input type="text" id="MailHost" name="MailHost" value="@n.Mail.Host" class="mat-input mat-mono" placeholder="smtp.example.com" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                        <mat-field label="Port" for-id="MailPort">
                            <input type="number" id="MailPort" name="MailPort" value="@n.Mail.Port" min="1" max="65535" class="mat-input mat-mono" inputmode="numeric" data-msg-range="Please enter a port from 1 to 65535." />
                        </mat-field>
                        <mat-field label="Security" for-id="MailTls">
                            <select id="MailTls" name="MailTls" class="mat-select">
                                <option value="StartTls" selected="@(n.Mail.Tls == MailTls.StartTls)">STARTTLS (port 587)</option>
                                <option value="Tls" selected="@(n.Mail.Tls == MailTls.Tls)">TLS (port 465)</option>
                                <option value="None" selected="@(n.Mail.Tls == MailTls.None)">None</option>
                            </select>
                        </mat-field>
                        <mat-field label="Username" for-id="MailUsername">
                            <input type="text" id="MailUsername" name="MailUsername" value="@n.Mail.Username" class="mat-input" autocomplete="off" autocapitalize="none" />
                        </mat-field>
                        <mat-field label="Password" for-id="MailPassword">
                            <input type="password" id="MailPassword" name="MailPassword" class="mat-input" placeholder="@(string.IsNullOrEmpty(n.Mail.Password) ? "" : keep)" autocomplete="new-password" />
                        </mat-field>
                        <mat-field label="From" for-id="MailFrom">
                            <input type="email" id="MailFrom" name="MailFrom" value="@n.Mail.From" class="mat-input" placeholder="matddns@example.com" autocomplete="off" autocapitalize="none" data-msg-type="Please enter an e-mail address." />
                        </mat-field>
                        <mat-field label="To" for-id="MailTo" full="true">
                            <input type="text" id="MailTo" name="MailTo" value="@n.Mail.To" class="mat-input" placeholder="admin@example.com, ops@example.com" autocomplete="off" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                    </div>
                </div>
            </div>

            <div class="mat-card">
                <div class="mat-card__head"><icon name="plug" /><h2 class="mat-card__title">Webhook</h2></div>
                <div class="mat-card__body mat-stack">
                    <label class="mat-check"><input type="checkbox" id="WebhookEnabled" name="WebhookEnabled" value="true" checked="@n.Webhook.Enabled" /><span class="mat-check__text">Call a webhook</span></label>
                    <div class="mat-form__grid" data-show-if="#WebhookEnabled" data-show-value="true" hidden="@(!n.Webhook.Enabled)">
                        <mat-field label="Format" for-id="WebhookFormat">
                            <select id="WebhookFormat" name="WebhookFormat" class="mat-select">
                                <option value="Json" selected="@(n.Webhook.Format == WebhookFormat.Json)">JSON</option>
                                <option value="Ntfy" selected="@(n.Webhook.Format == WebhookFormat.Ntfy)">ntfy</option>
                                <option value="Gotify" selected="@(n.Webhook.Format == WebhookFormat.Gotify)">Gotify</option>
                            </select>
                        </mat-field>
                        <mat-field label="URL" for-id="WebhookUrl" full="true">
                            <input type="password" id="WebhookUrl" name="WebhookUrl" class="mat-input mat-mono" placeholder="@(string.IsNullOrEmpty(n.Webhook.Url) ? "https://ntfy.sh/my-topic or https://gotify.example.com/message?token=…" : $"{SystemModel.UrlHint(n.Webhook.Url)} – {keep.ToLowerInvariant()}")" autocomplete="new-password" autocapitalize="none" spellcheck="false" />
                        </mat-field>
                    </div>
                </div>
            </div>

            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                <button type="submit" class="mat-btn mat-btn--secondary" asp-page-handler="TestNotifications"><icon name="bell" /><span>Save and send a test</span></button>
            </div>
        </form>
    </div>

    <div class="mat-tabpanel" role="tabpanel" id="panel-api" aria-labelledby="tab-api" hidden="@(Model.Tab != "api")">
        <div class="mat-stack">
            <p class="mat-muted">Endpoints without sign-in for monitors, routers and other Matddns instances. None of them shows a password or key.</p>

            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Endpoints without sign-in</caption>
                    <thead><tr><th scope="col">Endpoint</th><th scope="col">Purpose</th></tr></thead>
                    <tbody>
                        <tr><td data-label="Endpoint" class="mat-mono mat-nowrap">GET /healthz</td><td data-label="Purpose">Liveness: <code>ok</code> while the app runs.</td></tr>
                        <tr><td data-label="Endpoint" class="mat-mono mat-nowrap">GET /api/health</td><td data-label="Purpose"><code>ok</code>, <code>degraded</code> or <code>down</code> with counts. HTTP 200 unless down; <code>?strict=1</code> answers 503 unless ok.</td></tr>
                        <tr><td data-label="Endpoint" class="mat-mono mat-nowrap">GET /api/state</td><td data-label="Purpose">Every source IP, every rule and the recent IP changes.</td></tr>
                        <tr><td data-label="Endpoint" class="mat-mono mat-nowrap">GET /api/update</td><td data-label="Purpose">A device pushes its IP into a DynDNS Server source (JSON answer).</td></tr>
                        <tr><td data-label="Endpoint" class="mat-mono mat-nowrap">GET /nic/update</td><td data-label="Purpose">The same in the dyndns2 format for routers (<code>good</code>, <code>nochg</code>).</td></tr>
                        <tr><td data-label="Endpoint" class="mat-mono mat-nowrap">GET /api/source</td><td data-label="Purpose">The source IPs for a Matddns peer source on another instance.</td></tr>
                    </tbody>
                </table>
            </div>

            <p class="mat-muted">The token of a DynDNS Server source opens the last three. The management API <code>/api/v1</code> (for Mattiverse) needs the header <code>X-Api-Key</code> with <code>MATDDNS_API_KEY</code> and is off without it.</p>
        </div>
    </div>
</div>
