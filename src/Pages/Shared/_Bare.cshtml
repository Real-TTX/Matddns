@inject Toolkit Toolkit
@{
    // A page without a menu: sign-in, an error. A centred card on the plain page background (rule SHELL-11).
    var title = ViewData["Title"] as string;
    var assetTag = Matddns.Services.BuildInfo.CacheTag;
}
<!DOCTYPE html>
<html lang="en" data-app="@Ui.App.Id">
<partial name="_Head" model="@(string.IsNullOrEmpty(title) ? Ui.App.Name : $"{title} · {Ui.App.Name}")" />
<body>
    <a class="mat-skip" href="#main">Skip to the content</a>
    @Html.Raw(Toolkit.Sprite)
    <main class="mat-auth" id="main">
        @RenderBody()
    </main>
    <script src="~/matui/matui.js?v=@assetTag"></script>
    <script src="~/js/matddns.js?v=@assetTag" data-sw="/sw.js?v=@assetTag"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
