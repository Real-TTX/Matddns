@* Small tag for objects that another system owns (the "managedBy" field, set by Mattiverse through the management API). Model: the managedBy value. *@
@model string?
@if (!string.IsNullOrWhiteSpace(Model))
{
    var who = Labels.ManagedBy(Model);
    <span class="mat-tag" title="Created by @who. Manual changes may be overwritten.">Managed by @who</span>
}
