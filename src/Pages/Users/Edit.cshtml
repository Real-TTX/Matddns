@page
@model Matddns.Pages.Users.EditModel
@{
    var isNew = Model.IsNew;
    ViewData["Title"] = isNew ? "New user" : Model.Username;
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@(isNew ? "New user" : Model.Username)</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notice)) { <div class="alert alert--success"><icon name="check-circle" /><span>@Model.Notice</span></div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div> }

<div class="card" style="max-width:640px;">
    <div class="card__body">
        @if (isNew)
        {
            <form method="post" asp-page-handler="Create" class="mat-form">
                <div class="form-grid">
                    <div class="mat-field">
                        <label class="mat-label" for="NewUsername">Username</label>
                        <input type="text" id="NewUsername" name="NewUsername" class="mat-input" required autocomplete="off" autocapitalize="none" spellcheck="false" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="NewPassword">Password</label>
                        <input type="password" id="NewPassword" name="NewPassword" class="mat-input" required autocomplete="new-password" />
                    </div>
                </div>
                <div class="mat-buttons">
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Create user</span></button>
                    <a class="mat-btn mat-btn--ghost" href="/System"><icon name="back" /><span>Back</span></a>
                </div>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Save" class="mat-form">
                <input type="hidden" name="Name" value="@Model.Username" />
                <div class="form-grid">
                    <div class="mat-field">
                        <label class="mat-label">Username</label>
                        <input type="text" value="@Model.Username" class="mat-input" disabled />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="NewPassword">New password</label>
                        <input type="password" id="NewPassword" name="NewPassword" class="mat-input" placeholder="leave empty = unchanged" autocomplete="new-password" />
                    </div>
                </div>
                <div class="mat-buttons">
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>Save</span></button>
                    <a class="mat-btn mat-btn--ghost" href="/System"><icon name="back" /><span>Back</span></a>
                    <span class="mat-buttons__spacer"></span>
                    @if (Model.IsCurrentUser)
                    {
                        <span class="text-muted small">You can't delete the account you're logged in as.</span>
                    }
                    else
                    {
                        <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" asp-route-Name="@Model.Username" data-confirm="Delete user @Model.Username?"><icon name="trash" /><span>Delete user</span></button>
                    }
                </div>
            </form>
        }
    </div>
</div>
