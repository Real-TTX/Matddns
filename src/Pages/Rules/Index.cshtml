@page
@model Matddns.Pages.Rules.IndexModel
@{
    ViewData["Title"] = "Rules";
    ViewData["Reconnect"] = "reload";
    ViewData["Crumbs"] = Crumbs.Of(("Rules", null));
    var list = Model.List;
}

<div class="mat-list">
    <partial name="_Toolbar" model="list.Toolbar" />

    @if (list.Items.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon"><icon name="route" /></span>
            @if (list.Toolbar.Total == 0)
            {
                <div class="mat-empty__title">No rules yet</div>
                <a class="mat-btn mat-btn--primary" href="/Rules/Edit"><icon name="plus" /><span>Create the first rule</span></a>
            }
            else
            {
                <div class="mat-empty__title">Nothing matches</div>
                <p>No rule matches. Change the search or the filter.</p>
                <a class="mat-btn mat-btn--secondary" href="/Rules">Reset the tools</a>
            }
        </div>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Rules</caption>
                <thead>
                    <tr><th scope="col">Record</th><th scope="col" class="mat-hide-sm">Source</th><th scope="col">Address</th><th scope="col">Status</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr>
                </thead>
                <tbody>
                @foreach (var r in list.Items)
                {
                    var statusKey = IndexModel.StatusKey(r);
                    var state = statusKey switch { "ok" => "ok", "issue" => "err", "pending" => "warn", _ => "none" };
                    var statusText = statusKey switch { "ok" => "OK", "issue" => "Problem", "pending" => "Pending", _ => "Disabled" };
                    if (r.Dynamic)
                    {
                        var dsrc = Model.AllSources.FirstOrDefault(s => s.Id == r.DynamicSourceId);
                        var dzone = Model.AllDomains.FirstOrDefault(d => d.Id == r.DomainGroupId);
                        <tr class="md-parent">
                            <td data-label="Record"><div class="mat-table__name"><a class="mat-mono" href="/Rules/Dynamic?id=@r.Id">@Model.RecordText(r)</a></div></td>
                            <td data-label="Source" class="mat-hide-sm mat-muted">@(dsrc?.Name ?? "?") <span class="mat-tag">dynamic</span></td>
                            <td data-label="Writes to" class="mat-muted">@(dzone?.Name ?? "?")</td>
                            <td data-label="Status"><span class="@Ui.Pill(state)">@statusText</span></td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Rules/Dynamic?id=@r.Id" aria-label="Edit the dynamic rule @Model.RecordText(r)" data-tip="Edit"><icon name="edit" /></a>
                                </div>
                            </td>
                        </tr>
                        continue;
                    }

                    var sourceIds = r.SourceEntryIdsInOrder;
                    var recordType = Model.TargetEntry(r)?.Type.ToString() ?? "A";
                    var triggerText = (r.OnChange, r.IntervalSeconds > 0) switch
                    {
                        (true, true) => $"on change, every {r.IntervalSeconds} s",
                        (true, false) => "on change",
                        (false, true) => $"every {r.IntervalSeconds} s",
                        _ => "manual"
                    };
                    var activeLabel = !string.IsNullOrEmpty(r.LastUsedSourceId) && Model.SourceLookup.ContainsKey(r.LastUsedSourceId)
                        ? Model.SourceLabel(r.LastUsedSourceId)
                        : (sourceIds.Count > 0 ? Model.SourceLabel(sourceIds[0]) : null);
                    <tr class="md-parent @(sourceIds.Count > 0 ? "has-children" : "")">
                        <td data-label="Record"><div class="mat-table__name"><a class="mat-mono" href="/Rules/Edit?id=@r.Id">@Model.RecordText(r)</a><partial name="_ManagedBadge" model="r.ManagedBy" /></div></td>
                        <td data-label="Source" class="mat-hide-sm mat-muted">@(activeLabel ?? "no sources")</td>
                        <td data-label="Address" class="mat-mono">@(!string.IsNullOrEmpty(r.LastValue) ? r.LastValue : "–")</td>
                        <td data-label="Status"><span class="@Ui.Pill(state)">@statusText</span> <span class="mat-muted mat-hide-sm">@triggerText</span></td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Rules/Edit?id=@r.Id" aria-label="Edit the rule @Model.RecordText(r)" data-tip="Edit"><icon name="edit" /></a>
                            </div>
                        </td>
                    </tr>
                    @if (sourceIds.Count > 0)
                    {
                        for (var i = 0; i < sourceIds.Count; i++)
                        {
                            var sid = sourceIds[i];
                            var resolved = Model.SourceLookup.TryGetValue(sid, out var rv) ? rv : null;
                            var label = resolved?.Entry.Label ?? "(unknown source)";
                            var sip = RecordAddress.For(recordType, resolved?.Entry.CurrentIp, resolved?.Entry.CurrentIpv6);
                            var hasIp = !string.IsNullOrEmpty(sip);
                            var isActive = r.Enabled && sid == r.LastUsedSourceId;
                            var childState = isActive ? "ok" : (hasIp ? "none" : "warn");
                            var childText = isActive ? "Active" : (hasIp ? "Standby" : "No IP");
                            <tr class="md-child @(i == sourceIds.Count - 1 ? "is-last" : "")">
                                <td data-label="Source"><span class="md-child__name">#@(i + 1) @label</span></td>
                                <td data-label="Group" class="mat-hide-sm">@(resolved?.Group.Name ?? "")</td>
                                <td data-label="Address" class="mat-mono">@(sip ?? "–")</td>
                                <td data-label="Status"><span class="@Ui.Pill(childState)">@childText</span></td>
                                <td></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="md-child is-last">
                            <td data-label="Source"><span class="md-child__name">No sources: add them to the failover order</span></td>
                            <td data-label="Group" class="mat-hide-sm"></td>
                            <td data-label="Address"></td>
                            <td data-label="Status"></td>
                            <td></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }

    <partial name="_Pager" model="list.Pager" />

    <div class="mat-actions">
        <a href="/Rules/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New rule</span></a>
        <a href="/Rules/Dynamic" class="mat-btn mat-btn--secondary"><icon name="plus" /><span>New dynamic rule</span></a>
    </div>
</div>
