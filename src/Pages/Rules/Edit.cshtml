@page
@model Matddns.Pages.Rules.EditModel
@functions {
    // uniform source-picker label: "Source · Entry — <current IP>" (interface id is never shown — it can be very long, e.g. UniFi Cloud host ids)
    static string SrcOption(Matddns.Models.SourceGroup sg, Matddns.Models.SourceEntry se)
    {
        var ip = !string.IsNullOrEmpty(se.CurrentIp) ? se.CurrentIp
               : (!string.IsNullOrEmpty(se.CurrentIpv6) ? se.CurrentIpv6 : null);
        return $"{sg.Name} · {se.Label}" + (ip != null ? $" — {ip}" : "");
    }
}
@{
    var r = Model.RuleItem;
    var isNew = Model.IsNew;
    var de = Model.TargetEntry;
    var isCname = de?.Type == DnsRecordType.CNAME;
    var title = isNew ? "New rule" : $"{de?.Type} {de?.Hostname ?? "(target missing)"}";
    ViewData["Title"] = title;
    ViewData["ManagedBy"] = r?.ManagedBy;
    ViewData["Crumbs"] = Crumbs.Of(("Rules", "/Rules"), (title, null));
    ViewData["ActiveHref"] = "/Rules";
}

@if (isNew && !Model.HasAnyRecord)
{
    <div class="mat-alert mat-alert--danger" role="alert">
        <icon name="x-circle" />
        <div class="mat-alert__body">No record yet. First create a record under <a href="/Domains">Domains</a>, for example <span class="mat-mono">home1.example.com (A)</span>.</div>
    </div>
    <div class="mat-actions"><a class="mat-btn mat-btn--secondary" href="/Rules"><icon name="back" /><span>Back</span></a></div>
}
else
{
    @if (!isNew && !string.IsNullOrEmpty(r!.LastResult))
    {
        var state = r.LastResult.StartsWith("ok", StringComparison.OrdinalIgnoreCase) ? "ok"
            : r.LastResult.StartsWith("err", StringComparison.OrdinalIgnoreCase) ? "err" : "warn";
        <p class="mat-muted">Last run @Tz.Format(r.LastRun) (@Tz.Label()) · <span class="@Ui.Pill(state)">@r.LastResult</span></p>
    }

    <form method="post" asp-page-handler="@(isNew ? "Create" : "Save")" class="mat-form" novalidate>
        @if (!isNew) { <input type="hidden" name="Id" value="@r!.Id" /> }
        <partial name="_ValidationSummary" />

        <div class="mat-card">
            <div class="mat-card__body mat-stack">
                <div class="mat-form__grid">
                    <mat-field label="Record" for-id="DomainEntryRef" required="true" full="true">
                        <select id="DomainEntryRef" name="DomainEntryRef" class="mat-select" required data-msg-required="Please select a record.">
                            @if (isNew) { <option value="">Select a record</option> }
                            @foreach (var d in Model.AllDomains)
                            {
                                foreach (var entry in d.Entries)
                                {
                                    var sel = r != null && d.Id == r.DomainGroupId && entry.Id == r.DomainEntryId;
                                    <option value="@(d.Id):@(entry.Id)" selected="@sel">@entry.Display · @d.Name</option>
                                }
                            }
                        </select>
                    </mat-field>

                    <div class="mat-field">
                        <label class="mat-label" for="IntervalSeconds">Re-check every (seconds)</label>
                        <input type="number" id="IntervalSeconds" name="IntervalSeconds" value="@(r?.IntervalSeconds ?? 300)" min="0" max="86400" class="mat-input mat-mono" inputmode="numeric" />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>

                    <div class="mat-field mat-field--full">
                        <label class="mat-check"><input type="checkbox" id="OnChange" name="OnChange" value="true" checked="@(r == null || r.OnChange)" /><span class="mat-check__text">React immediately when a source IP changes</span></label>
                        @if (!isNew)
                        {
                            <label class="mat-check"><input type="checkbox" id="Enabled" name="Enabled" value="true" checked="@r!.Enabled" /><span class="mat-check__text">Enabled</span></label>
                        }
                    </div>
                </div>

                <fieldset class="mat-fieldset">
                    <legend class="mat-label">Failover validation</legend>
                    <div class="mat-form__grid">
                        <div class="mat-field mat-field--full">
                            <label class="mat-check"><input type="checkbox" id="ValidatePing" name="ValidatePing" value="true" checked="@(r != null && r.ValidatePing)" /><span class="mat-check__text">Ping (ICMP)</span></label>
                            <label class="mat-check"><input type="checkbox" id="validateTcp" name="ValidateTcp" value="true" checked="@(r != null && r.ValidateTcp)" /><span class="mat-check__text">TCP port open</span></label>
                        </div>
                        <div class="mat-field" data-show-if="#validateTcp" data-show-value="true" hidden="@(r == null || !r.ValidateTcp)">
                            <label class="mat-label" for="ValidationPort">Port</label>
                            <input type="number" id="ValidationPort" name="ValidationPort" value="@(r?.ValidationPort ?? 443)" min="1" max="65535" class="mat-input mat-mono" inputmode="numeric" />
                            <span class="mat-error" aria-live="polite"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>

        @if (isNew)
        {
            <section class="mat-section">
                <div class="mat-section__head"><h2>Failover sources</h2></div>
                @if (Model.AllSources.SelectMany(s => s.Entries).Any())
                {
                    <div class="mat-card" data-failover-picker>
                        <div class="mat-card__body mat-stack">
                            <div data-failover-list></div>
                            <div class="mat-form__grid">
                                <div class="mat-field mat-field--full">
                                    <label class="mat-label" for="newSrcSelect">Add a source</label>
                                    <div class="mat-input-group">
                                        <select id="newSrcSelect" class="mat-select" data-failover-select>
                                            <option value="">Select a source</option>
                                            @foreach (var sg in Model.AllSources)
                                            {
                                                foreach (var se in sg.Entries)
                                                {
                                                    var lbl = SrcOption(sg, se);
                                                    <option value="@se.Id" data-label="@lbl">@lbl</option>
                                                }
                                            }
                                        </select>
                                        <button type="button" class="mat-btn mat-btn--secondary" data-failover-add><icon name="plus" /><span>Add</span></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="mat-muted">No sources yet. <a href="/Sources/Edit">Add a source</a> first.</p>
                }
            </section>
        }

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>@(isNew ? "Create" : "Save")</span></button>
            @if (!isNew)
            {
                <button type="submit" class="mat-btn mat-btn--secondary" asp-page-handler="RunNow" asp-route-Id="@r!.Id"><icon name="play" /><span>Run now</span></button>
            }
            <a class="mat-btn mat-btn--secondary" href="/Rules"><icon name="back" /><span>Back</span></a>
            @if (!isNew)
            {
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" asp-route-Id="@r!.Id" data-confirm="Delete this rule?" data-confirm-ok="Delete rule"><icon name="trash" /><span>Delete</span></button>
            }
        </div>
    </form>

    @if (!isNew)
    {
        <section class="mat-section">
            <div class="mat-section__head"><h2>Failover order</h2></div>
            <form method="post" asp-page-handler="SaveSources" class="mat-form" novalidate>
                <input type="hidden" name="Id" value="@r!.Id" />
                <div class="mat-card">
                    <div class="mat-card__body">
                        @if (r.SourceEntryIdsInOrder.Count == 0)
                        {
                            <p class="mat-muted">No sources yet. Add one below.</p>
                        }
                        else
                        {
                            <div>
                            @for (int i = 0; i < r.SourceEntryIdsInOrder.Count; i++)
                            {
                                var sid = r.SourceEntryIdsInOrder[i];
                                var info = Model.SourceLookup.TryGetValue(sid, out var v) ? v : null;
                                var ip = RecordAddress.For(de?.Type.ToString() ?? "A", info?.Entry.CurrentIp, info?.Entry.CurrentIpv6);
                                var status = info == null ? "none" : (string.IsNullOrEmpty(ip) ? "warn" : "ok");
                                var cname = i < r.CnameTargets.Count ? r.CnameTargets[i] : "";
                                var name = info != null ? $"{info.Group.Name} · {info.Entry.Label}" : "(unknown source)";
                                <div class="md-failover__row @(isCname ? "md-failover__row--cname" : "")">
                                    <span class="md-failover__index mat-mono">#@(i + 1)</span>
                                    <div class="md-failover__name">
                                        <div>@name</div>
                                        <span class="@Ui.Pill(status) mat-mono">@(ip ?? "–")</span>
                                    </div>
                                    @if (isCname)
                                    {
                                        <div><input name="CnameTargets" value="@cname" class="mat-input mat-mono" placeholder="target.example.com" aria-label="CNAME target of @name" autocapitalize="none" spellcheck="false" /></div>
                                    }
                                    else
                                    {
                                        <input type="hidden" name="CnameTargets" value="@cname" />
                                    }
                                    <div class="md-failover__actions">
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page-handler="MoveSource" asp-route-Id="@r.Id" asp-route-SourceId="@sid" asp-route-Dir="-1" data-tip="Move up" aria-label="Move @name up" disabled="@(i == 0)"><icon name="arrow-up" /></button>
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page-handler="MoveSource" asp-route-Id="@r.Id" asp-route-SourceId="@sid" asp-route-Dir="1" data-tip="Move down" aria-label="Move @name down" disabled="@(i == r.SourceEntryIdsInOrder.Count - 1)"><icon name="arrow-down" /></button>
                                        <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" asp-page-handler="RemoveSource" asp-route-Id="@r.Id" asp-route-SourceId="@sid" data-confirm="Remove @name from this rule?" data-confirm-ok="Remove" data-tip="Remove" aria-label="Remove @name"><icon name="x" /></button>
                                    </div>
                                    <input type="hidden" name="SourceEntryIdsInOrder" value="@sid" />
                                </div>
                            }
                            </div>
                        }
                    </div>
                </div>
                @if (r.SourceEntryIdsInOrder.Count > 0)
                {
                    <div class="mat-actions">
                        <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>@(isCname ? "Save order and CNAME targets" : "Save order")</span></button>
                    </div>
                }
            </form>
        </section>

        <section class="mat-section">
            <div class="mat-section__head"><h2>Add a source</h2></div>
            <form method="post" asp-page-handler="AddSource" class="mat-form" novalidate>
                <input type="hidden" name="Id" value="@r!.Id" />
                <div class="mat-card">
                    <div class="mat-card__body">
                        <div class="mat-form__grid">
                            <mat-field label="Source" for-id="SourceEntryId" required="true" full="true">
                                <select id="SourceEntryId" name="SourceEntryId" class="mat-select" required data-msg-required="Please select a source.">
                                    <option value="">Select a source</option>
                                    @foreach (var sg in Model.AllSources)
                                    {
                                        foreach (var se in sg.Entries)
                                        {
                                            if (r.SourceEntryIdsInOrder.Contains(se.Id)) continue;
                                            <option value="@se.Id">@SrcOption(sg, se)</option>
                                        }
                                    }
                                </select>
                            </mat-field>
                        </div>
                    </div>
                </div>
                <div class="mat-actions">
                    <button type="submit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add source</span></button>
                </div>
            </form>
        </section>
    }
}
