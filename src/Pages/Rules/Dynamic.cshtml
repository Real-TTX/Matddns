@page
@model Matddns.Pages.Rules.DynamicModel
@{
    var r = Model.RuleItem;
    var isNew = Model.IsNew;
    var title = isNew ? "New dynamic rule" : "Dynamic rule";
    ViewData["Title"] = title;
    ViewData["Crumbs"] = Crumbs.Of(("Rules", "/Rules"), (title, null));
    ViewData["ActiveHref"] = "/Rules";
    var src = isNew ? null : Model.PushSources.FirstOrDefault(s => s.Id == r!.DynamicSourceId);
}

@if (isNew && (Model.PushSources.Count == 0 || Model.NetcupGroups.Count == 0))
{
    <div class="mat-alert mat-alert--danger" role="alert">
        <icon name="x-circle" />
        <div class="mat-alert__body">A dynamic rule needs at least one DynDNS Server source and one Netcup domain group.</div>
    </div>
}

<form method="post" asp-page-handler="@(isNew ? "Create" : "Save")" class="mat-form" novalidate>
    @if (!isNew) { <input type="hidden" name="Id" value="@r!.Id" /> }
    <partial name="_ValidationSummary" />

    <div class="mat-card">
        <div class="mat-card__body mat-stack">
            <div class="mat-form__grid">
                <mat-field label="Receiver (DynDNS Server)" for-id="DynamicSourceId">
                    <select id="DynamicSourceId" name="DynamicSourceId" class="mat-select">
                        @foreach (var s in Model.PushSources)
                        {
                            <option value="@s.Id" selected="@(r?.DynamicSourceId == s.Id)">@s.Name</option>
                        }
                    </select>
                </mat-field>
                <mat-field label="Target zone (Netcup)" for-id="DomainGroupId">
                    <select id="DomainGroupId" name="DomainGroupId" class="mat-select">
                        @foreach (var d in Model.NetcupGroups)
                        {
                            <option value="@d.Id" selected="@(r?.DomainGroupId == d.Id)">@d.Name</option>
                        }
                    </select>
                </mat-field>
                <mat-field label="Zone" for-id="DynamicZone" required="true">
                    <input type="text" id="DynamicZone" name="DynamicZone" value="@(r?.DynamicZone ?? "")" class="mat-input mat-mono" required placeholder="example.com" autocapitalize="none" spellcheck="false" data-msg-required="Please enter the zone, for example example.com." />
                </mat-field>
                <mat-field label="Namespace prefix" for-id="DynamicPrefix">
                    <input type="text" id="DynamicPrefix" name="DynamicPrefix" value="@(r?.DynamicPrefix ?? "")" class="mat-input mat-mono" placeholder="dynamic" autocapitalize="none" spellcheck="false" />
                </mat-field>
                @if (!isNew)
                {
                    <div class="mat-field mat-field--full">
                        <label class="mat-check"><input type="checkbox" id="Enabled" name="Enabled" value="true" checked="@r!.Enabled" /><span class="mat-check__text">Enabled</span></label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>@(isNew ? "Create" : "Save")</span></button>
        <a class="mat-btn mat-btn--secondary" href="/Rules"><icon name="back" /><span>Back</span></a>
        @if (!isNew)
        {
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" name="Id" value="@r!.Id" data-confirm="Delete this dynamic rule?" data-confirm-ok="Delete"><icon name="trash" /><span>Delete</span></button>
        }
    </div>
</form>

@if (!isNew)
{
    <section class="mat-section">
        <div class="mat-section__head"><h2>Namespace</h2></div>
        <div class="mat-card">
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>Allowed</dt><dd class="mat-mono">*.@r!.DynamicBaseFqdn</dd>
                    <dt>The device sends</dt><dd class="mat-mono">&amp;hostname=&lt;name&gt;.@r.DynamicBaseFqdn</dd>
                    @if (src != null)
                    {
                        <dt>Token and update URL</dt><dd><a href="/Sources/Edit?id=@src.Id">@src.Name</a></dd>
                    }
                </dl>
            </div>
        </div>
    </section>
}
