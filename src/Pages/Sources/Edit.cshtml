@page
@model Matddns.Pages.Sources.EditModel
@{
    var g = Model.Group;
    var isNew = Model.IsNew;
    var kind = g?.Kind ?? SourceKind.PublicIp;
    ViewData["Title"] = isNew ? "New source" : g!.Name;

    // DynDNS Server (push) receiver: the URLs shown to the device / router
    var baseUrl = Model.BaseUrl;
    var token = g?.Push?.Token ?? "";
    var host = baseUrl.Replace("https://", "").Replace("http://", "");
    var isDyn = Model.DynamicRule != null;
    var baseFqdn = Model.DynamicRule?.DynamicBaseFqdn ?? "";
}

<div class="page-head">
    <div class="page-head__title">
        <h1>@(isNew ? "New source group" : g!.Name)</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notice)) { <div class="alert alert--success"><icon name="check-circle" /><span>@Model.Notice</span></div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert--error"><icon name="x-circle" /><span>@Model.Error</span></div> }

@if (!string.IsNullOrEmpty(Model.TestResult))
{
    <div class="alert @(Model.TestOk ? "alert--success" : "alert--error")">
        <icon name="@(Model.TestOk ? "check-circle" : "x-circle")" />
        <span><strong>@(Model.TestOk ? "Test succeeded" : "Test failed")</strong><br /><span class="mono">@Model.TestResult</span></span>
    </div>
}

<div class="card">
    <div class="card__body">
        <form method="post" asp-page-handler="@(isNew ? "Create" : "Save")" class="mat-form">
            @if (!isNew) { <input type="hidden" name="Id" value="@g!.Id" /> }

            <div class="form-grid">
                <div class="mat-field">
                    <label class="mat-label" for="Name">Name</label>
                    <input type="text" id="Name" name="Name" value="@(g?.Name ?? "")" class="mat-input" required placeholder="e.g. Home Unifi" />
                </div>

                <div class="mat-field">
                    <label class="mat-label" for="@(isNew ? "kindSelect" : "kindFixed")">Type</label>
                    @if (isNew)
                    {
                        <select name="Kind" id="kindSelect" class="mat-select">
                            <option value="PublicIp">Public IP</option>
                            <option value="Unifi">Unifi</option>
                            <option value="UnifiCloud">UniFi Cloud</option>
                            <option value="Static">Static IP</option>
                            <option value="Push">DynDNS Server</option>
                            <option value="Dns">DNS lookup</option>
                            <option value="Fritzbox">FRITZ!Box</option>
                            <option value="Matddns">Matddns peer</option>
                        </select>
                    }
                    else
                    {
                        var typeLabel = kind switch { SourceKind.Unifi => "Unifi", SourceKind.UnifiCloud => "UniFi Cloud", SourceKind.Static => "Static IP", SourceKind.Push => "DynDNS Server", SourceKind.Dns => "DNS lookup", SourceKind.Fritzbox => "FRITZ!Box", SourceKind.Matddns => "Matddns peer", _ => "Public IP" };
                        <input type="text" id="kindFixed" value="@typeLabel" class="mat-input" disabled />
                    }
                </div>

                @if (isNew || kind != SourceKind.Push)
                {
                    <div class="mat-field span-2" data-show-if="#kindSelect" data-hide-value="Push">
                        <label class="mat-label" for="IntervalSeconds">Interval (seconds)</label>
                        <input type="number" id="IntervalSeconds" name="IntervalSeconds" value="@(g?.IntervalSeconds ?? 60)" min="15" class="mat-input" inputmode="numeric" />
                    </div>
                }
            </div>

            @* The type-specific fields: all are in the form, only the block of the chosen type is shown (data-show-if). *@

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Unifi" hidden="@(kind != SourceKind.Unifi)">
                <div class="form-grid">
                    <div class="mat-field">
                        <label class="mat-label" for="UniUrl">Base URL</label>
                        <input type="text" id="UniUrl" name="UniUrl" value="@(g?.Unifi?.BaseUrl ?? "")" class="mat-input" placeholder="https://10.10.0.1" autocapitalize="none" spellcheck="false" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="UniSite">Site</label>
                        <input type="text" id="UniSite" name="UniSite" value="@(g?.Unifi?.Site ?? "default")" class="mat-input" autocapitalize="none" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="UniUser">Username</label>
                        <input type="text" id="UniUser" name="UniUser" value="@(g?.Unifi?.Username ?? "")" class="mat-input" autocomplete="off" autocapitalize="none" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="UniPass">Password</label>
                        <input type="password" id="UniPass" name="UniPass" class="mat-input" placeholder="@(isNew ? "" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-switch">
                            <input type="checkbox" name="UniIgnoreCert" value="true" @(g?.Unifi?.IgnoreCertificate != false ? "checked" : "") />
                            <span>Ignore self-signed certificate</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="PublicIp" hidden="@(kind != SourceKind.PublicIp)"></div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Static" hidden="@(kind != SourceKind.Static)">
                <div class="form-grid">
                    <div class="mat-field">
                        <label class="mat-label" for="StaticIp">Static IPv4</label>
                        <input type="text" id="StaticIp" name="StaticIp" value="@(g?.Static?.Ip ?? "")" class="mat-input" placeholder="203.0.113.10" inputmode="decimal" autocapitalize="none" spellcheck="false" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="StaticIpv6">Static IPv6</label>
                        <input type="text" id="StaticIpv6" name="StaticIpv6" value="@(g?.Static?.Ipv6 ?? "")" class="mat-input" placeholder="2001:db8::1" autocapitalize="none" spellcheck="false" />
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Dns" hidden="@(kind != SourceKind.Dns)">
                <div class="form-grid">
                    <div class="mat-field span-2">
                        <label class="mat-label" for="DnsHost">Hostname</label>
                        <input type="text" id="DnsHost" name="DnsHost" value="@(g?.Dns?.Hostname ?? "")" class="mat-input" placeholder="xxxxxxxx.myfritz.net" autocapitalize="none" spellcheck="false" />
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Fritzbox" hidden="@(kind != SourceKind.Fritzbox)">
                <div class="form-grid">
                    <div class="mat-field span-2">
                        <label class="mat-label" for="FbUrl">Address (TR-064)</label>
                        <input type="text" id="FbUrl" name="FbUrl" value="@(g?.Fritzbox?.BaseUrl ?? "")" class="mat-input" placeholder="http://fritz.box:49000  ·  or https://xxxxxxxx.myfritz.net:port" autocapitalize="none" spellcheck="false" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="FbUser">Username</label>
                        <input type="text" id="FbUser" name="FbUser" value="@(g?.Fritzbox?.Username ?? "")" class="mat-input" autocomplete="off" autocapitalize="none" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="FbPass">Password</label>
                        <input type="password" id="FbPass" name="FbPass" class="mat-input" placeholder="@(isNew ? "" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-switch">
                            <input type="checkbox" name="FbIgnoreCert" value="true" @(g?.Fritzbox?.IgnoreCertificate == true ? "checked" : "") />
                            <span>Ignore self-signed certificate (MyFRITZ! TLS)</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Matddns" hidden="@(kind != SourceKind.Matddns)">
                <div class="form-grid">
                    <div class="mat-field span-2">
                        <label class="mat-label" for="MdUrl">Peer base URL</label>
                        <input type="text" id="MdUrl" name="MdUrl" value="@(g?.Matddns?.BaseUrl ?? "")" class="mat-input" placeholder="https://dyndns.example.com" autocapitalize="none" spellcheck="false" />
                    </div>
                    <div class="mat-field span-2">
                        <label class="mat-label" for="MdToken">Token</label>
                        <input type="password" id="MdToken" name="MdToken" class="mat-input" placeholder="@(isNew ? "a DynDNS-Server token on the peer" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="UnifiCloud" hidden="@(kind != SourceKind.UnifiCloud)">
                <div class="form-grid">
                    <div class="mat-field span-2">
                        <label class="mat-label" for="UcKey">API key</label>
                        <input type="password" id="UcKey" name="UcKey" class="mat-input" placeholder="@(isNew ? "Site Manager key (unifi.ui.com → API)" : "•••••• (leave empty = unchanged)")" autocomplete="new-password" />
                    </div>
                </div>
            </div>

            <div class="type-fields" data-show-if="#kindSelect" data-show-value="Push" hidden="@(kind != SourceKind.Push)">
                @if (!isNew)
                {
                    <div class="form-grid">
                        <div class="mat-field span-2">
                            <label class="mat-label" for="pushUrl">Update URL</label>
                            <input type="text" id="pushUrl" value="@(isDyn ? $"{baseUrl}/update?token={token}&hostname=<name>.{baseFqdn}&myip=%i" : $"{baseUrl}/api/update?token={token}&ipv4=<your-ipv4>&ipv6=<your-ipv6>")" class="mat-input mono" readonly data-select />
                            @if (isDyn)
                            {
                                <p class="text-muted small" style="margin:6px 0 0;">Dynamic receiver: the device sends <span class="mono">&amp;hostname=&lt;name&gt;.@baseFqdn</span> (its own name under the namespace) — that record is created/updated.</p>
                            }
                            <div><button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" style="margin-top:8px;" data-dialog-open="#pushDocs"><icon name="file" /><span>Documentation</span></button></div>
                        </div>
                        <div class="mat-field span-2">
                            <label class="mat-label" for="pushToken">Token</label>
                            <input type="text" id="pushToken" value="@token" class="mat-input mono" readonly data-select />
                        </div>
                    </div>

                    @if (isDyn)
                    {
                        <p class="text-muted small" style="margin-top:14px;">Dynamic receiver — a <a href="/Rules/Dynamic?id=@Model.DynamicRule!.Id">dynamic rule</a> writes pushes to <span class="mono">*.@baseFqdn</span>.</p>
                    }
                }
            </div>

            <div class="mat-buttons">
                <button type="submit" class="mat-btn mat-btn--primary"><icon name="save" /><span>@(isNew ? "Create" : "Save")</span></button>
                @if (!isNew)
                {
                    @if (kind == SourceKind.Unifi || kind == SourceKind.PublicIp || kind == SourceKind.Dns || kind == SourceKind.Fritzbox || kind == SourceKind.Matddns)
                    {
                        <button type="submit" class="mat-btn mat-btn--ghost" asp-page-handler="Test" name="Id" value="@g!.Id"><icon name="plug" /><span>Test connection</span></button>
                    }
                    @if (kind != SourceKind.Push)
                    {
                        <button type="submit" class="mat-btn mat-btn--ghost" asp-page-handler="Refresh" name="Id" value="@g!.Id"><icon name="refresh" /><span>Check now</span></button>
                    }
                    @if (kind == SourceKind.Push)
                    {
                        <button type="submit" class="mat-btn mat-btn--ghost" asp-page-handler="RegenerateToken" name="Id" value="@g!.Id" data-confirm="Generate a new token? The old one stops working immediately." data-confirm-ok="Regenerate"><icon name="refresh" /><span>Regenerate token</span></button>
                    }
                }
                <a class="mat-btn mat-btn--ghost" href="/Sources"><icon name="back" /><span>Back</span></a>
                @if (!isNew)
                {
                    <span class="mat-buttons__spacer"></span>
                    <button type="submit" class="mat-btn mat-btn--danger" asp-page-handler="Delete" name="Id" value="@g!.Id" data-confirm="Remove group and all entries?" data-confirm-ok="Delete group"><icon name="trash" /><span>Delete group</span></button>
                }
            </div>
        </form>
    </div>
</div>

@if (!isNew && kind != SourceKind.UnifiCloud)
{
    <div class="section-head"><h2 class="section-title">Entries</h2></div>
    <div class="mat-table">
        <div class="mat-table__scroll">
        <table class="data">
            <thead>
                <tr>
                    <th>Label</th>
                    <th class="hide-sm">Interface</th>
                    <th>IPv4</th>
                    <th class="hide-sm">IPv6</th>
                    <th class="hide-sm">Last check</th>
                    <th>Status</th>
                    @if (kind == SourceKind.Unifi) { <th class="actions"></th> }
                </tr>
            </thead>
            <tbody>
            @foreach (var e in g!.Entries)
            {
                var noIp = string.IsNullOrEmpty(e.CurrentIp) && string.IsNullOrEmpty(e.CurrentIpv6);
                var status = e.LastError == null ? (noIp ? "warn" : "ok") : "err";
                <tr>
                    <td>@e.Label</td>
                    <td class="mono hide-sm">@(e.InterfaceName ?? "—")</td>
                    <td class="mono">@(e.CurrentIp ?? "—")</td>
                    <td class="mono hide-sm">@(e.CurrentIpv6 ?? "—")</td>
                    <td class="hide-sm text-muted small">@Tz.Format(e.LastChecked)</td>
                    <td><span class="pill @Ui.Pill(status)" title="@(e.LastError ?? "")">@(e.LastError != null ? "error" : (noIp ? "pending" : "ok"))</span></td>
                    @if (kind == SourceKind.Unifi)
                    {
                        <td class="actions">
                            <form method="post" asp-page-handler="DeleteEntry" class="inline-form" data-confirm="Remove entry @e.Label?" data-confirm-ok="Remove">
                                <input type="hidden" name="Id" value="@g.Id" />
                                <input type="hidden" name="EntryId" value="@e.Id" />
                                <button type="submit" class="mat-btn mat-btn--sm mat-btn--icon mat-btn--danger" title="Remove" aria-label="Remove entry"><icon name="trash" /></button>
                            </form>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
        </div>
    </div>
}

@if (!isNew && kind == SourceKind.UnifiCloud)
{
    <div class="section-head"><h2 class="section-title">Gateways</h2></div>
    <div class="mat-table">
        <div class="mat-table__scroll">
        <table class="data">
            <thead><tr><th>Gateway</th><th>IPv4</th><th class="hide-sm">IPv6</th><th class="hide-sm">Last check</th><th>Status</th><th class="actions"></th></tr></thead>
            <tbody>
            @foreach (var e in g!.Entries)
            {
                var noIp = string.IsNullOrEmpty(e.CurrentIp) && string.IsNullOrEmpty(e.CurrentIpv6);
                var status = e.LastError == null ? (noIp ? "warn" : "ok") : "err";
                <tr>
                    <td>@e.Label</td>
                    <td class="mono">@(e.CurrentIp ?? "—")</td>
                    <td class="mono hide-sm">@(e.CurrentIpv6 ?? "—")</td>
                    <td class="hide-sm text-muted small">@Tz.Format(e.LastChecked)</td>
                    <td><span class="pill @Ui.Pill(status)" title="@(e.LastError ?? "")">@(e.LastError != null ? "error" : (noIp ? "pending" : "ok"))</span></td>
                    <td class="actions">
                        <form method="post" asp-page-handler="DeleteEntry" class="inline-form" data-confirm="Remove gateway @e.Label?" data-confirm-ok="Remove">
                            <input type="hidden" name="Id" value="@g.Id" />
                            <input type="hidden" name="EntryId" value="@e.Id" />
                            <button type="submit" class="mat-btn mat-btn--sm mat-btn--icon mat-btn--danger" title="Remove" aria-label="Remove gateway"><icon name="trash" /></button>
                        </form>
                    </td>
                </tr>
            }
            @if (g.Entries.Count == 0)
            {
                <tr><td colspan="6" class="text-muted">No gateways added yet — pick from the list below.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>

    <div class="section-head"><h2 class="section-title">Add gateway</h2></div>
    <div class="card">
        <div class="card__body">
            @if (!string.IsNullOrEmpty(Model.GatewayError))
            {
                <div class="alert alert--error" style="margin-bottom:0;"><icon name="x-circle" /><span>@Model.GatewayError</span></div>
            }
            else if (Model.AvailableGateways.Count == 0)
            {
                <p class="text-muted" style="margin:0;">@(g!.Entries.Count > 0 ? "All visible gateways are already added." : "No gateways visible for this key.")</p>
            }
            else
            {
                <form method="post" asp-page-handler="AddGateway" class="mat-form">
                    <input type="hidden" name="Id" value="@g!.Id" />
                    <div class="form-grid">
                        <div class="mat-field">
                            <label class="mat-label" for="HostId">Gateway</label>
                            <select id="HostId" name="HostId" class="mat-select" required>
                                @foreach (var h in Model.AvailableGateways)
                                {
                                    <option value="@h.Id">@h.Name — @(h.Ipv4 ?? h.Ipv6 ?? "no IP")</option>
                                }
                            </select>
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="Alias">Alias name</label>
                            <input type="text" id="Alias" name="Alias" class="mat-input" placeholder="optional — defaults to the gateway name" autocomplete="off" />
                        </div>
                    </div>
                    <div class="mat-buttons" style="margin-top:0;">
                        <button type="submit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>Add gateway</span></button>
                    </div>
                </form>
            }
        </div>
    </div>
}

@if (!isNew && kind == SourceKind.Push)
{
    <dialog id="pushDocs" class="mat-dialog">
        <div class="mat-dialog__head">
            <span>DynDNS Server — setup</span>
            <button type="button" class="mat-btn mat-btn--sm mat-btn--icon mat-btn--ghost" aria-label="Close" data-dialog-close><icon name="x" /></button>
        </div>
        <div class="mat-dialog__body">
            <p class="text-muted small" style="margin-top:0;">The token is pre‑filled below. Use a host reachable from the device — not localhost.</p>

            <details name="pushdocs" class="acc">
                <summary>FRITZ!Box</summary>
                <div class="acc-body">
                    <label class="mat-label" for="fritzUrl" style="display:block; margin:10px 0 6px;">Update URL</label>
                    <input type="text" id="fritzUrl" value="@(isDyn ? $"{baseUrl}/nic/update?token={token}&hostname=<domain>&ipv4=<ipaddr>&ipv6=<ip6addr>" : $"{baseUrl}/nic/update?token={token}&ipv4=<ipaddr>&ipv6=<ip6addr>")" class="mat-input mono" readonly data-select />
                    @if (isDyn)
                    {
                        <p class="text-muted small" style="margin:6px 0 0;">Internet → Permit Access → DynDNS → <em>custom provider</em>. Set <strong>Domainname</strong> = <span class="mono">&lt;name&gt;.@baseFqdn</span> — FRITZ!Box sends it as <span class="mono">&lt;domain&gt;</span>; user / password can be anything.</p>
                    }
                    else
                    {
                        <p class="text-muted small" style="margin:6px 0 0;">Internet → Permit Access → DynDNS → <em>custom provider</em>. Domain / user / password can be anything; FRITZ!Box fills <span class="mono">&lt;ipaddr&gt;</span> / <span class="mono">&lt;ip6addr&gt;</span>.</p>
                    }
                </div>
            </details>

            <details name="pushdocs" class="acc">
                <summary>UniFi (UDM / UGW)</summary>
                <div class="acc-body">
                    <p class="text-muted small" style="margin:10px 0 8px;">Settings → Internet → <em>your WAN</em> → Dynamic DNS → <strong>Create New</strong></p>
                    <table class="data api-table">
                        <tbody>
                            <tr><td>Service</td><td class="mono">custom</td></tr>
                            <tr>
                                <td>Hostname</td>
                                @if (isDyn) { <td><span class="mono">&lt;name&gt;.@baseFqdn</span> — becomes the record</td> }
                                else { <td>any FQDN, label only — e.g. <span class="mono">wan.example.com</span></td> }
                            </tr>
                            <tr><td>Username</td><td class="mono">matddns</td></tr>
                            <tr><td>Password</td><td class="mono">@token</td></tr>
                            <tr><td>Server</td><td class="mono">@(isDyn ? $"{host}/update?token=%p&hostname=%h&ipv4=%i" : $"{host}/update?token=%p&ipv4=%i")</td></tr>
                        </tbody>
                    </table>
                    @if (isDyn)
                    {
                        <p class="text-muted small" style="margin:8px 0 0;"><strong>Dynamic:</strong> set <strong>Hostname</strong> = <span class="mono">&lt;name&gt;.@baseFqdn</span>; <span class="mono">%h</span> sends it as the record to create/update.</p>
                    }
                    <p class="text-muted small" style="margin:8px 0 0;"><strong>Server: no <span class="mono">http://</span> / <span class="mono">https://</span></strong> — bare host only, or UniFi's client tries to resolve the scheme as a hostname and never sends. Fill <strong>Password</strong> with the token; <span class="mono">%p</span> mirrors it into the URL and <span class="mono">%i</span> becomes the WAN IPv4 (both are placeholders — UniFi keeps those, drops plain text). Connects over HTTPS.</p>
                    <p class="text-muted small" style="margin:6px 0 0;"><strong>IPv4 only:</strong> UniFi has no IPv6 placeholder, so one entry tracks the WAN IPv4. For dual‑stack use the FRITZ!Box section (separate <span class="mono">&lt;ip6addr&gt;</span>).</p>
                    <p class="text-muted small" style="margin:6px 0 0;"><strong>Same‑network gotcha:</strong> if the UDM's DDNS host resolves to its own public IP, the request loops back to the UDM (NAT hairpin). Add a local DNS record so <span class="mono">@host</span> resolves to this server's internal IP.</p>
                </div>
            </details>
        </div>
        <div class="mat-dialog__foot">
            <button type="button" class="mat-btn mat-btn--primary" data-dialog-close>Close</button>
        </div>
    </dialog>
}
