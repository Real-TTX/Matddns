@page
@model Matddns.Pages.Sources.IndexModel
@{
    ViewData["Title"] = "Sources";
    ViewData["Reconnect"] = "reload";
    ViewData["Crumbs"] = Crumbs.Of(("Sources", null));
    var list = Model.List;
}

<div class="mat-list">
    <partial name="_Toolbar" model="list.Toolbar" />

    @if (list.Items.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon"><icon name="network" /></span>
            @if (list.Toolbar.Total == 0)
            {
                <div class="mat-empty__title">No sources yet</div>
                <a class="mat-btn mat-btn--primary" href="/Sources/Edit"><icon name="plus" /><span>Create the first source</span></a>
            }
            else
            {
                <div class="mat-empty__title">Nothing matches</div>
                <p>No source matches. Change the search or the filters.</p>
                <a class="mat-btn mat-btn--secondary" href="/Sources">Reset the tools</a>
            }
        </div>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Sources</caption>
                <thead>
                    <tr><th scope="col">Name</th><th scope="col" class="mat-hide-sm">Type</th><th scope="col">IPv4</th><th scope="col" class="mat-hide-sm">IPv6</th><th scope="col">Status</th><th scope="col"><span class="mat-sr-only">Actions</span></th></tr>
                </thead>
                <tbody>
                @foreach (var g in list.Items)
                {
                    var state = Labels.State(g);
                    var schedule = g.Kind == SourceKind.Push ? "push-driven" : (g.IntervalSeconds > 0 ? $"every {g.IntervalSeconds} s" : "no polling");
                    var entries = g.Entries.ToList();
                    var multi = entries.Count > 1;
                    var first = entries.FirstOrDefault();
                    <tr class="md-parent @(multi ? "has-children" : "")">
                        <td data-label="Name"><div class="mat-table__name"><a href="/Sources/Edit?id=@g.Id">@g.Name</a><partial name="_ManagedBadge" model="g.ManagedBy" /></div></td>
                        <td data-label="Type" class="mat-hide-sm"><span class="mat-tag">@Labels.Source(g.Kind)</span> <span class="mat-muted">@schedule</span></td>
                        <td data-label="IPv4" class="mat-mono">@(multi ? "" : (first?.CurrentIp ?? "–"))</td>
                        <td data-label="IPv6" class="mat-hide-sm mat-mono">@(multi ? "" : (first?.CurrentIpv6 ?? "–"))</td>
                        <td data-label="Status"><span class="@Ui.Pill(state)">@Labels.StateText(state)</span></td>
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Sources/Edit?id=@g.Id" aria-label="Edit @g.Name" data-tip="Edit"><icon name="edit" /></a>
                            </div>
                        </td>
                    </tr>
                    @if (multi)
                    {
                        for (var i = 0; i < entries.Count; i++)
                        {
                            var e = entries[i];
                            var entryState = e.LastError != null ? "err" : ((!string.IsNullOrEmpty(e.CurrentIp) || !string.IsNullOrEmpty(e.CurrentIpv6)) ? "ok" : "warn");
                            <tr class="md-child @(i == entries.Count - 1 ? "is-last" : "")">
                                <td data-label="Entry"><span class="md-child__name">@e.Label</span></td>
                                <td data-label="Type" class="mat-hide-sm"></td>
                                <td data-label="IPv4" class="mat-mono">@(e.CurrentIp ?? "–")</td>
                                <td data-label="IPv6" class="mat-hide-sm mat-mono">@(e.CurrentIpv6 ?? "–")</td>
                                <td data-label="Status"><span class="@Ui.Pill(entryState)" title="@(e.LastError ?? "")">@Labels.StateText(entryState)</span></td>
                                <td></td>
                            </tr>
                        }
                    }
                }
                </tbody>
            </table>
        </div>
    }

    <partial name="_Pager" model="list.Pager" />

    <div class="mat-actions">
        <a href="/Sources/Edit" class="mat-btn mat-btn--primary"><icon name="plus" /><span>New source</span></a>
    </div>
</div>
