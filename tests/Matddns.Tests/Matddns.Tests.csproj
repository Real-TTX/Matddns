<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Matddns.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The results as a summary of the GitHub Actions run (the logger GitHubActions of dotnet test). -->
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- The whole app in memory (platform contract, sign-in through MatIdentity, the engine API, the peer endpoints). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Newer than what Mvc.Testing brings (10.0.11 has known vulnerabilities). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Matddns.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon sprite of MatUi (a copy of MatDesign src/MatUi/wwwroot/img/matui-icons.svg; this branch of Matddns has no MatUi yet):
         the icons a MatApiDefinition may name - Mattiverse draws them with it. -->
    <None Update="Fixtures\matui-icons.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
